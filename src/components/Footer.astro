---
import { SITE_CONFIG, NAV_ITEMS, TOOL_ITEMS } from '../data/site';
---

<footer class="bg-brand-navy text-gray-300 text-sm mt-auto border-t border-brand-dark">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Column 1: Brand & Site Mission -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img src="/images/logo.svg" alt="机场指南 Logo" class="h-8 w-auto brightness-0 invert" />
        </div>
        <p class="text-xs text-gray-400 leading-relaxed max-w-sm">
          {SITE_CONFIG.description}
        </p>
        <div class="bg-brand-dark/60 p-3 rounded-lg border border-gray-800 text-xs text-gray-400 space-y-1.5">
          <div class="text-brand-accent font-semibold flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>商业中立与透明原则</span>
          </div>
          <p class="text-[11px] text-gray-400">
            我们不冒充任何服务商官方、认证机构或独立测评室。任何商业推广入口均严格标注 <code class="text-gray-300">rel="nofollow sponsored"</code>，且客观实测数据与风险警示绝不接受商业买断或排序篡改。
          </p>
        </div>
      </div>

      <!-- Column 2: 核心专题 -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">核心决策专题</h3>
        <ul class="space-y-2 text-xs">
          {NAV_ITEMS.slice(0, 5).map(item => (
            <li>
              <a href={item.href} class="hover:text-brand-accent transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: 技术与支持 -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">技术与排障</h3>
        <ul class="space-y-2 text-xs">
          {NAV_ITEMS.slice(5).map(item => (
            <li>
              <a href={item.href} class="hover:text-brand-accent transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: 选购工具与合规 -->
      <div>
        <h3 class="text-xs font-semibold text-white uppercase tracking-wider mb-3">工具与合规</h3>
        <ul class="space-y-2 text-xs">
          {TOOL_ITEMS.map(tool => (
            <li>
              <a href={tool.href} class="text-emerald-400 hover:text-emerald-300 transition-colors flex items-center gap-1">
                <span>{tool.label}</span>
              </a>
            </li>
          ))}
          <li class="pt-2 border-t border-gray-800">
            <a href="/methodology/" class="hover:text-brand-accent transition-colors">测评方法论</a>
          </li>
          <li>
            <a href="/disclosure/" class="hover:text-brand-accent transition-colors">商业披露透明声明</a>
          </li>
          <li>
            <a href="/sources/" class="hover:text-brand-accent transition-colors">数据来源与快照</a>
          </li>
          <li>
            <a href="/corrections/" class="hover:text-brand-accent transition-colors">勘误与更正机制</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Legal & Verification Strip -->
    <div class="mt-10 pt-6 border-t border-gray-800/80 flex flex-col md:flex-row items-center justify-between text-xs text-gray-500 gap-4">
      <div>
        © 2020–{new Date().getFullYear()} {SITE_CONFIG.name} (jichang.biz). 保留所有权利。
      </div>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a href="/about/" class="hover:text-gray-300">关于本站</a>
        <a href="/privacy/" class="hover:text-gray-300">隐私权政策</a>
        <a href="/contact/" class="hover:text-gray-300">联系我们</a>
        <a href="/sitemap-index.xml" class="hover:text-gray-300">Sitemap</a>
        <a href="/llms.txt" class="hover:text-gray-300">llms.txt</a>
      </div>
    </div>
  </div>
</footer>
