---
import { SITE_CONFIG, VERIFICATION_CONFIG } from '../data/site';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface FAQItem {
  question: string;
  answer: string;
}

export interface ReviewData {
  itemReviewedName: string;
  ratingValue: number;
  bestRating?: number;
  worstRating?: number;
}

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'collection';
  breadcrumbs?: BreadcrumbItem[];
  faqItems?: FAQItem[];
  reviewData?: ReviewData;
  author?: string;
  category?: string;
  tags?: string[];
  cover?: string;
  publishDate?: string;
  modifiedDate?: string;
  noindex?: boolean;
}

const {
  title = SITE_CONFIG.name + ' - 网络服务选购决策与套餐对比中心',
  description = SITE_CONFIG.description,
  canonicalUrl,
  type = 'website',
  breadcrumbs = [],
  faqItems = [],
  reviewData,
  author = SITE_CONFIG.author,
  category,
  tags = [],
  cover,
  publishDate,
  modifiedDate,
  noindex = false
} = Astro.props;

const siteUrl = SITE_CONFIG.domain;

// Strict Canonical Normalization (Always enforce official domain https://jichang.biz and consistent trailing slash)
let rawUrl = canonicalUrl || Astro.url.href;
if (rawUrl.startsWith('/')) {
  rawUrl = `${siteUrl}${rawUrl}`;
} else {
  try {
    const parsed = new URL(rawUrl);
    rawUrl = `${siteUrl}${parsed.pathname}`;
  } catch (e) {
    rawUrl = `${siteUrl}/`;
  }
}
rawUrl = rawUrl.split('?')[0].split('#')[0];
if (!rawUrl.endsWith('/') && !rawUrl.split('/').pop()?.includes('.')) {
  rawUrl += '/';
}
const normalizedCanonical = rawUrl;

// Schemas
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_CONFIG.name,
  url: siteUrl,
  logo: `${siteUrl}/images/logo.svg`,
  description: SITE_CONFIG.description
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_CONFIG.name,
  url: siteUrl,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const collectionSchema = type === 'collection' ? {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  url: normalizedCanonical
} : null;

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`
  }))
} : null;

const faqSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
} : null;

const articleSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Organization',
    name: author || SITE_CONFIG.name
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/logo.svg`
    }
  },
  datePublished: publishDate || '2026-11-20T08:00:00+08:00',
  dateModified: modifiedDate || publishDate || '2026-11-24T12:00:00+08:00',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': normalizedCanonical
  }
} : null;

const reviewSchema = reviewData ? {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: title,
  reviewBody: description,
  itemReviewed: {
    '@type': 'Service',
    name: reviewData.itemReviewedName
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: reviewData.ratingValue,
    bestRating: reviewData.bestRating || 10,
    worstRating: reviewData.worstRating || 1
  },
  author: {
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    url: siteUrl
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    url: siteUrl
  },
  datePublished: publishDate || '2026-11-20T08:00:00+08:00',
  dateModified: modifiedDate || publishDate || '2026-11-24T12:00:00+08:00'
} : null;

const ogImage = cover || `${siteUrl}/images/logo.svg`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={normalizedCanonical} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
)}

<!-- 搜索引擎站长平台安全验证 (预留配置，按需激活，绝不伪造) -->
{VERIFICATION_CONFIG.google && <meta name="google-site-verification" content={VERIFICATION_CONFIG.google} />}
{VERIFICATION_CONFIG.bing && <meta name="msvalidate.01" content={VERIFICATION_CONFIG.bing} />}
{VERIFICATION_CONFIG.shenma && <meta name="shenma-site-verification" content={VERIFICATION_CONFIG.shenma} />}
{VERIFICATION_CONFIG.baidu && <meta name="baidu-site-verification" content={VERIFICATION_CONFIG.baidu} />}

<!-- 中文搜索引擎与移动端兼容声明 (百度/神马/夸克/UC自适应声明) -->
<meta name="applicable-device" content="pc,mobile" />
<meta name="format-detection" content="telephone=no" />
<meta name="renderer" content="webkit" />

<!-- Open Graph -->
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={normalizedCanonical} />
<meta property="og:site_name" content={SITE_CONFIG.name} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={ogImage} />

{type === 'article' && (
  <>
    <meta property="article:published_time" content={publishDate || '2026-11-20T08:00:00+08:00'} />
    <meta property="article:modified_time" content={modifiedDate || publishDate || '2026-11-24T12:00:00+08:00'} />
    <meta property="article:author" content={author} />
    {category && <meta property="article:section" content={category} />}
    {tags && tags.map(tag => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content={cover ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Favicon / Brand Identity -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{collectionSchema && <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />}
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
{reviewSchema && <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
