---
import { SITE_CONFIG, NAV_ITEMS, TOOL_ITEMS } from '../data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-brand-border">
  <!-- Top Announcement / Transparency Banner -->
  <div class="bg-brand-navy text-white text-xs py-1 px-4 text-center border-b border-brand-dark flex items-center justify-center gap-2">
    <span class="inline-block w-2 h-2 rounded-full bg-brand-teal animate-pulse"></span>
    <span>选购决策中心：所有价格、测速与解锁状态均附带核验日期与数据来源，拒绝虚构实测</span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0 focus:outline-none focus:ring-2 focus:ring-brand-teal rounded-lg p-1" aria-label="机场指南首页">
        <img src="/images/logo.svg" alt="机场指南 jichang.biz" class="h-9 w-auto" />
      </a>

      <!-- Desktop Navigation Bar -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 text-sm font-medium" aria-label="全站核心导航">
        {NAV_ITEMS.slice(0, 6).map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-2.5 py-1.5 rounded-md transition-colors duration-150',
              isActive(item.href)
                ? 'bg-brand-light text-brand-teal font-semibold border border-brand-border'
                : 'text-brand-dark hover:text-brand-teal hover:bg-brand-light'
            ]}
          >
            {item.label}
          </a>
        ))}

        <!-- Secondary Dropdown for Remaining Hubs -->
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1 px-2.5 py-1.5 rounded-md text-brand-dark hover:text-brand-teal hover:bg-brand-light transition-colors"
            aria-haspopup="true"
            aria-expanded="false"
            id="more-nav-button"
          >
            <span>更多专题</span>
            <svg class="w-4 h-4 text-brand-muted group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            class="absolute left-0 mt-1 w-56 bg-white border border-brand-border rounded-lg shadow-lg py-1.5 hidden group-hover:block group-focus-within:block focus:outline-none"
            role="menu"
            aria-labelledby="more-nav-button"
          >
            {NAV_ITEMS.slice(6).map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block px-4 py-2 text-xs transition-colors',
                  isActive(item.href)
                    ? 'bg-brand-light text-brand-teal font-semibold'
                    : 'text-brand-dark hover:bg-brand-light hover:text-brand-teal'
                ]}
                role="menuitem"
              >
                <div class="font-medium">{item.label}</div>
                <div class="text-[11px] text-brand-muted">{item.description}</div>
              </a>
            ))}
          </div>
        </div>

        <!-- Decision Tools Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="flex items-center gap-1 px-3 py-1.5 rounded-md bg-emerald-50 text-brand-teal hover:bg-emerald-100 transition-colors border border-emerald-200"
            aria-haspopup="true"
            aria-expanded="false"
            id="tools-button"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <span class="font-semibold">决策工具</span>
          </button>
          <div
            class="absolute right-0 mt-1 w-64 bg-white border border-brand-border rounded-lg shadow-lg py-1.5 hidden group-hover:block group-focus-within:block focus:outline-none"
            role="menu"
            aria-labelledby="tools-button"
          >
            {TOOL_ITEMS.map((tool) => (
              <a
                href={tool.href}
                class="block px-4 py-2.5 text-xs text-brand-dark hover:bg-brand-light hover:text-brand-teal transition-colors"
                role="menuitem"
              >
                <div class="font-semibold text-brand-teal flex items-center justify-between">
                  <span>{tool.label}</span>
                  <span class="text-[10px] bg-brand-light px-1.5 py-0.5 rounded border border-brand-border text-brand-muted">实时</span>
                </div>
                <div class="text-[11px] text-brand-muted mt-0.5">{tool.description}</div>
              </a>
            ))}
          </div>
        </div>
      </nav>

      <!-- Search Trigger & Mobile Menu Toggle -->
      <div class="flex items-center gap-2">
        <a
          href="/search/"
          class="flex items-center gap-2 text-xs text-brand-muted bg-brand-light hover:bg-gray-200/70 border border-brand-border px-3 py-1.5 rounded-md transition-colors"
          aria-label="打开搜索"
        >
          <svg class="w-4 h-4 text-brand-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">搜索品牌、节点、教程...</span>
          <span class="sm:hidden">搜索</span>
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white border border-brand-border rounded text-brand-muted">⌘K</kbd>
        </a>

        <!-- Mobile hamburger button -->
        <button
          type="button"
          class="lg:hidden p-2 rounded-md text-brand-dark hover:bg-brand-light border border-brand-border"
          id="mobile-menu-toggle"
          aria-label="展开或收起手机导航菜单"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div class="lg:hidden hidden bg-white border-b border-brand-border px-4 pt-2 pb-6" id="mobile-menu">
    <div class="grid grid-cols-2 gap-2 py-3 border-b border-brand-border">
      <a href="/tools/plan-finder/" class="p-2.5 rounded bg-emerald-50 text-brand-teal text-xs font-semibold flex items-center gap-1.5">
        <span>🧭 智能筛选器</span>
      </a>
      <a href="/compare/" class="p-2.5 rounded bg-blue-50 text-brand-info text-xs font-semibold flex items-center gap-1.5">
        <span>⚖️ 品牌并排比</span>
      </a>
      <a href="/tools/cost-calculator/" class="p-2.5 rounded bg-amber-50 text-brand-warning text-xs font-semibold flex items-center gap-1.5">
        <span>💰 成本折算器</span>
      </a>
      <a href="/tools/traffic-calculator/" class="p-2.5 rounded bg-purple-50 text-purple-700 text-xs font-semibold flex items-center gap-1.5">
        <span>📊 流量估算器</span>
      </a>
    </div>

    <div class="mt-3 space-y-1">
      <div class="text-[11px] font-semibold text-brand-muted uppercase px-2 mb-1">核心栏目导航</div>
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class:list={[
            'flex items-center justify-between px-3 py-2 rounded text-sm',
            isActive(item.href)
              ? 'bg-brand-light text-brand-teal font-semibold'
              : 'text-brand-dark hover:bg-brand-light'
          ]}
        >
          <span>{item.label}</span>
          <span class="text-xs text-brand-muted">{item.description}</span>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggleBtn && menu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }
</script>
