---
import type { BrandEntity } from '../types/brand';
import EvidenceStatus from './EvidenceStatus.astro';
import { getAffiliateLink } from '../data/links';

interface Props {
  brand: BrandEntity;
}

const { brand } = Astro.props;
const aff = getAffiliateLink(brand.id);
---

<div class:list={[
  'bg-white border rounded-xl p-5 transition-all duration-200 hover:shadow-md flex flex-col justify-between relative',
  brand.isPartner ? 'border-brand-teal/80 ring-1 ring-brand-teal/20 bg-emerald-50/10' : 'border-brand-border'
]}>
  
  <!-- Partner Ribbon / Header Badges -->
  <div>
    <div class="flex items-start justify-between gap-2 mb-2.5">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${brand.colorAccent};`}></span>
          <h3 class="text-base font-bold text-brand-dark hover:text-brand-teal transition-colors">
            <a href={`/brands/${brand.slug}/`}>{brand.name}</a>
          </h3>
          {brand.isPartner && (
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-brand-teal border border-emerald-300">
              合作品牌
            </span>
          )}
        </div>
        <div class="text-[11px] text-brand-muted mt-0.5">
          {brand.launchYear ? `${brand.launchYear} 年开业` : '运营时间待核实'} · {brand.networkType} 专线架构
        </div>
      </div>
      <EvidenceStatus status={brand.dataStatus} />
    </div>

    <!-- Tagline & Answer First -->
    <p class="text-xs text-brand-muted line-clamp-2 mb-3 leading-relaxed">
      {brand.tagline}
    </p>

    <!-- Key Spec Badges -->
    <div class="flex flex-wrap gap-1.5 mb-4 text-[11px]">
      <span class="px-2 py-0.5 rounded bg-brand-light text-brand-dark border border-brand-border font-mono">
        {brand.protocols.join(' / ')}
      </span>
      <span class="px-2 py-0.5 rounded bg-brand-light text-brand-dark border border-brand-border">
        {brand.clientSupport.hasCustomApp ? '自研客户端' : '通用订阅'}
      </span>
      {brand.clientSupport.supportsClash && (
        <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200">
          支持Clash
        </span>
      )}
      {brand.coverageRegions.slice(0, 3).map(r => (
        <span class="px-1.5 py-0.5 rounded bg-gray-50 text-gray-600 border border-gray-200">
          {r}
        </span>
      ))}
    </div>
  </div>

  <!-- Bottom Pricing & Action Strip -->
  <div class="pt-3 border-t border-brand-border mt-2">
    <div class="flex items-baseline justify-between mb-3">
      <div>
        <span class="text-[11px] text-brand-muted">起步门槛:</span>
        <span class="text-lg font-bold text-brand-teal font-mono-numbers ml-1">
          ¥{brand.startingPriceMonthlyYuan}
        </span>
        <span class="text-[11px] text-brand-muted font-normal">/月起</span>
      </div>
      {brand.promoCode && (
        <span class="text-[10px] text-brand-muted bg-amber-50 text-amber-800 border border-amber-200 px-1.5 py-0.5 rounded">
          码: <code class="font-bold">{brand.promoCode}</code>
        </span>
      )}
    </div>

    <div class="grid grid-cols-2 gap-2 text-xs font-medium">
      <a
        href={`/brands/${brand.slug}/`}
        class="py-2 px-3 text-center rounded-lg border border-brand-border bg-brand-light text-brand-dark hover:bg-gray-200/60 hover:text-brand-teal transition-colors"
      >
        查看完整评测
      </a>

      {aff ? (
        <a
          href={aff.url}
          target={aff.target}
          rel={aff.rel}
          class:list={[
            'py-2 px-3 text-center rounded-lg font-bold transition-all flex items-center justify-center gap-1',
            brand.isPartner
              ? 'bg-brand-teal text-white hover:bg-brand-accent shadow-sm'
              : 'bg-brand-navy text-white hover:bg-brand-dark'
          ]}
          title={aff.disclosureText}
        >
          <span>前往品牌官网</span>
          <svg class="w-3.5 h-3.5 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : (
        <span class="py-2 px-3 text-center rounded-lg bg-gray-100 text-gray-400 text-xs flex items-center justify-center">
          入口核验中
        </span>
      )}
    </div>

    <!-- Inline Disclosure Notice -->
    <div class="text-[10px] text-gray-400 text-center mt-2">
      {brand.isPartner ? '（合作品牌商业展示）' : '（含推广链接，可能产生佣金）'}
    </div>
  </div>

</div>
