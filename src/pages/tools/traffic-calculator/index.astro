---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = '月度流量消耗估算器 (Traffic Calculator) · 科学测算实际用量';
const description = '输入您的每日上网习惯（看视频、查资料、AI 对话、远程办公），精准估算您每月所需的网络代理流量，避免买多浪费或流量中途耗尽。';
const breadcrumbs = [
  { name: '决策工具', url: '/tools/' },
  { name: '流量估算器', url: '/tools/traffic-calculator/' }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Header -->
    <div class="max-w-2xl mb-8">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold border border-purple-200 mb-3">
        <span>📊 科学用量决策 · 纯客户端计算</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-brand-dark tracking-tight">
        月度流量消耗估算器 (Traffic Calculator)
      </h1>
      <p class="text-sm text-brand-muted mt-2 leading-relaxed">
        很多用户往往高估或低估自己的真实月度流量需求。通过输入您的典型日均活动时长，测算合理的月度套餐档位与容错建议。
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Inputs Area (2 cols) -->
      <div class="md:col-span-2 bg-white border border-brand-border rounded-xl p-6 shadow-sm space-y-5 text-xs">
        
        <h2 class="text-sm font-bold text-brand-dark pb-2 border-b border-brand-border">
          日常上网行为与时长输入（按每天估算）
        </h2>

        <!-- Activity 1: 网页查资料 -->
        <div>
          <div class="flex justify-between font-medium text-brand-dark mb-1">
            <span>📰 网页查资料、阅读技术文档与收发邮件</span>
            <span class="font-mono text-brand-teal font-bold"><span id="val-web">2</span> 小时/天</span>
          </div>
          <input type="range" id="input-web" min="0" max="10" step="0.5" value="2" class="w-full accent-brand-teal" />
          <div class="text-[11px] text-brand-muted mt-0.5">基准参考：约 150 MB / 小时</div>
        </div>

        <!-- Activity 2: 1080P 视频 -->
        <div>
          <div class="flex justify-between font-medium text-brand-dark mb-1">
            <span>📺 YouTube / Netflix 1080P 高清视频</span>
            <span class="font-mono text-brand-teal font-bold"><span id="val-video-1080">1.5</span> 小时/天</span>
          </div>
          <input type="range" id="input-video-1080" min="0" max="8" step="0.5" value="1.5" class="w-full accent-brand-teal" />
          <div class="text-[11px] text-brand-muted mt-0.5">基准参考：约 1.5 GB / 小时</div>
        </div>

        <!-- Activity 3: 4K 视频 -->
        <div>
          <div class="flex justify-between font-medium text-brand-dark mb-1">
            <span>🎬 4K 超高清视频 / 追高码率影视</span>
            <span class="font-mono text-brand-teal font-bold"><span id="val-video-4k">0</span> 小时/天</span>
          </div>
          <input type="range" id="input-video-4k" min="0" max="6" step="0.5" value="0" class="w-full accent-brand-teal" />
          <div class="text-[11px] text-brand-muted mt-0.5">基准参考：约 7.0 GB / 小时 (极其消耗流量)</div>
        </div>

        <!-- Activity 4: AI 对话 -->
        <div>
          <div class="flex justify-between font-medium text-brand-dark mb-1">
            <span>🤖 ChatGPT / Claude / Gemini 对话与提示词</span>
            <span class="font-mono text-brand-teal font-bold"><span id="val-ai">30</span> 次交互/天</span>
          </div>
          <input type="range" id="input-ai" min="0" max="200" step="5" value="30" class="w-full accent-brand-teal" />
          <div class="text-[11px] text-brand-muted mt-0.5">基准参考：纯文本交互流量极小，主要消耗在网页初次加载与代码输出</div>
        </div>

        <!-- Activity 5: 社交媒体 / TikTok -->
        <div>
          <div class="flex justify-between font-medium text-brand-dark mb-1">
            <span>📱 刷推特 (X) / Instagram / TikTok 资讯</span>
            <span class="font-mono text-brand-teal font-bold"><span id="val-social">1</span> 小时/天</span>
          </div>
          <input type="range" id="input-social" min="0" max="6" step="0.5" value="1" class="w-full accent-brand-teal" />
          <div class="text-[11px] text-brand-muted mt-0.5">基准参考：约 500 MB / 小时</div>
        </div>

        <!-- Activity 6: 额外月度大文件下载 -->
        <div class="pt-2 border-t border-brand-border">
          <label class="block font-medium text-brand-dark mb-1">
            💾 每月额外大文件下载或代码包拉取 (GB/月)
          </label>
          <input type="number" id="input-download" min="0" max="1000" value="10" class="w-full bg-brand-light border border-brand-border rounded-lg p-2 font-mono text-brand-dark" />
        </div>

      </div>

      <!-- Result Sidebar (1 col) -->
      <div class="space-y-4">
        
        <div class="bg-brand-navy border border-gray-800 rounded-xl p-5 text-white shadow-md">
          <div class="text-xs text-gray-400 font-mono">ESTIMATED MONTHLY QUOTA</div>
          <div class="text-3xl font-extrabold text-white font-mono-numbers mt-2">
            <span id="result-total-gb">95</span> <span class="text-sm font-normal text-emerald-400">GB/月</span>
          </div>
          <div class="text-xs text-gray-300 mt-2 pt-2 border-t border-gray-800">
            日均预计消耗: <strong class="text-emerald-400 font-mono-numbers" id="result-daily-gb">3.1 GB</strong>
          </div>

          <div class="mt-4 pt-3 border-t border-gray-800 space-y-2 text-xs">
            <div class="text-gray-400 font-bold">推荐购买套餐档位：</div>
            <div class="p-2.5 rounded bg-gray-900 border border-emerald-900 text-emerald-300 font-bold text-sm" id="result-tier-advice">
              建议选购 100GB – 150GB 档
            </div>
          </div>
        </div>

        <!-- Margin of Error Notes -->
        <div class="bg-white border border-brand-border rounded-xl p-4 text-xs text-brand-muted space-y-2">
          <div class="font-bold text-brand-dark flex items-center gap-1">
            <span>⚠️ 估算误差与缓冲建议</span>
          </div>
          <p class="leading-relaxed text-[11px]">
            1. 实际流量会受节点倍率（如部分线路 1.5 倍或 2 倍扣费）影响；<br/>
            2. 视频网站自适应码率（开启自动 1080P/4K）可能超出预期；<br/>
            3. 强烈建议在估算值基础上保留 <strong>20%–30% 的缓冲冗余</strong>，避免月中被限速或停机。
          </p>
        </div>

        <!-- Quick Link to Plan Finder -->
        <a href="/tools/plan-finder/" class="block text-center py-2.5 px-4 rounded-xl bg-brand-teal text-white font-bold text-xs hover:bg-brand-accent transition-colors shadow-sm">
          前往套餐筛选器匹配方案 →
        </a>

      </div>

    </div>

  </div>
</BaseLayout>

<script>
  function initTrafficCalculator() {
    const inputWeb = document.getElementById('input-web') as HTMLInputElement;
    const inputVideo1080 = document.getElementById('input-video-1080') as HTMLInputElement;
    const inputVideo4k = document.getElementById('input-video-4k') as HTMLInputElement;
    const inputAi = document.getElementById('input-ai') as HTMLInputElement;
    const inputSocial = document.getElementById('input-social') as HTMLInputElement;
    const inputDownload = document.getElementById('input-download') as HTMLInputElement;

    const valWeb = document.getElementById('val-web');
    const valVideo1080 = document.getElementById('val-video-1080');
    const valVideo4k = document.getElementById('val-video-4k');
    const valAi = document.getElementById('val-ai');
    const valSocial = document.getElementById('val-social');

    const resultTotalGb = document.getElementById('result-total-gb');
    const resultDailyGb = document.getElementById('result-daily-gb');
    const resultTierAdvice = document.getElementById('result-tier-advice');

    if (!inputWeb || !resultTotalGb) return;

    function calculate() {
      const hWeb = parseFloat(inputWeb.value) || 0;
      const hV1080 = parseFloat(inputVideo1080.value) || 0;
      const hV4k = parseFloat(inputVideo4k.value) || 0;
      const cAi = parseFloat(inputAi.value) || 0;
      const hSocial = parseFloat(inputSocial.value) || 0;
      const mDownload = parseFloat(inputDownload.value) || 0;

      // Update Label Displays
      if (valWeb) valWeb.textContent = hWeb.toString();
      if (valVideo1080) valVideo1080.textContent = hV1080.toString();
      if (valVideo4k) valVideo4k.textContent = hV4k.toString();
      if (valAi) valAi.textContent = cAi.toString();
      if (valSocial) valSocial.textContent = hSocial.toString();

      // Calculation Formula (GB/day)
      // Web: 0.15 GB/hr
      // Video 1080p: 1.5 GB/hr
      // Video 4k: 7.0 GB/hr
      // AI: 0.002 GB/query
      // Social: 0.5 GB/hr
      const dailyGB = (hWeb * 0.15) + (hV1080 * 1.5) + (hV4k * 7.0) + (cAi * 0.002) + (hSocial * 0.5);
      const monthlyGB = Math.round((dailyGB * 30) + mDownload);

      resultDailyGb!.textContent = dailyGB.toFixed(1) + ' GB';
      resultTotalGb!.textContent = monthlyGB.toString();

      // Recommendation tier
      if (monthlyGB <= 60) {
        resultTierAdvice!.textContent = '建议选购 60GB 极限平价档 (约 ¥5.6-¥8/月)';
      } else if (monthlyGB <= 130) {
        resultTierAdvice!.textContent = '建议选购 100GB–150GB 主流均衡档 (约 ¥15-¥25/月)';
      } else if (monthlyGB <= 350) {
        resultTierAdvice!.textContent = '建议选购 200GB–350GB 进阶多端档 (约 ¥30-¥45/月)';
      } else if (monthlyGB <= 700) {
        resultTierAdvice!.textContent = '建议选购 500GB–700GB 高清追剧档 (约 ¥60-¥100/月)';
      } else {
        resultTierAdvice!.textContent = '建议选购 1000GB+ 商业大容量或不限时包 (¥120+/月)';
      }
    }

    [inputWeb, inputVideo1080, inputVideo4k, inputAi, inputSocial, inputDownload].forEach(el => {
      el.addEventListener('input', calculate);
    });

    calculate();
  }

  document.addEventListener('DOMContentLoaded', initTrafficCalculator);
</script>
