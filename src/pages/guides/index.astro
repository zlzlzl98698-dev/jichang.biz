---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';

const title = '网络代理与客户端全平台使用教程 · 订阅导入、TUN 模式与规则分流原理全景指南';
const description = '面向合法合规使用场景的权威网络配置手册。全景指导 Windows、Android、iOS 与 macOS 四大平台客户端选择、订阅导入、TUN 虚拟网卡配置、Fake-IP 工作原理与防漏网排查。';
const breadcrumbs = [
  { name: '使用教程', url: '/guides/' }
];

const faqItems = [
  {
    question: '为什么我的订阅链接不能随意发给其他人或公开到网上？',
    answer: '订阅链接（Subscription URL）中包含您在服务商系统中的唯一 Token 身份凭据。任何拿到您订阅链接的人，均可将其直接导入自己的客户端并消耗您的套餐流量，甚至可能因多地 IP 同时高频并发触发服务商的防盗刷风控而导致您的账号被封禁。请务必将订阅地址视同账号密码妥善保管。'
  },
  {
    question: '开启 TUN 模式（虚拟网卡）和系统代理有什么区别？',
    answer: '系统代理模式仅在操作系统层面对主动遵循 HTTP/HTTPS 代理环境的软件（如 Edge、Chrome 浏览器）生效；而很多终端命令行工具（git/curl/python）、Steam/Epic 游戏客户端或非标准应用并不走系统代理。开启 TUN 模式后，客户端会在系统中虚拟出一张独立网卡接管所有出站流量，实现全局接管分流，彻底解决终端或游戏漏跑直连的问题。'
  },
  {
    question: '为什么有时候国内网站（如百度、淘宝）打不开了？',
    answer: '这通常是误将客户端代理模式切换为了“全局模式（Global）”导致。在全局模式下，所有国内流量都会绕道海外节点再访问国内服务器，导致延迟飙升甚至被国内反诈防护拦截。日常使用务必保持在“规则模式（Rule）”，确保国内流量走 Direct 直连，境外流量走 Proxy 代理。'
  },
  {
    question: '第三方在线订阅转换工具安全吗？有哪些潜在风险？',
    answer: '存在极高的安全隐患。使用未经验证的第三方公共在线订阅转换服务时，您的订阅 Token 会完整发送至对方服务器。不良运营者可能会在后台抓取存储您的订阅凭据、注入恶意劫持规则、替换推广返利返佣，甚至盗用您的专线流量。强烈建议优先使用客户端原生支持的订阅格式（如 Clash/Mihomo 或 Sing-box），或在本地电脑通过开源 subconverter 自建转换。'
  },
  {
    question: '客户端总是提示“订阅更新失败 (Network Error)”该如何解决？',
    answer: '主要原因包括：1. 当前本地网络无法直接访问机场订阅下发域名（此时可先连接可用热点或开启现有节点代理后再更新）；2. 机场下发服务器正在遭受 DDOS 攻击或临时维护；3. 电脑本地系统时间与网络授时时间存在偏差超过 60 秒，导致 TLS 证书握手校验失败；4. 机场订阅格式变更，客户端内核过旧无法解析新语法。'
  },
  {
    question: '什么是 Fake-IP 模式？它相比 Redir-Host 有什么优势？',
    answer: 'Fake-IP 模式是现代代理客户端处理 DNS 的革命性机制。传统模式需要客户端先在本地向 DNS 查询真实 IP，容易引发严重的 DNS 污染与解析延迟。而 Fake-IP 模式下，当本地软件发起域名请求时，客户端内核直接返回一个虚构的保留私网 IP（如 198.18.0.1/16），并记录映射表；真实的目标 IP 解析交由远端境外落地服务器完成，不仅极大降低了握手延迟，还能 100% 免疫本地 DNS 污染。'
  },
  {
    question: '如果订阅链接泄露了，该如何第一时间自救？',
    answer: '请立即登录机场官网后台的用户仪表盘，找到“重置订阅凭据（Reset Token）”或“重置订阅链接”按钮并确认。重置后，原有的旧订阅 URL 会立即永久失效，防止他人继续盗用流量；随后在您所有设备的客户端中重新粘贴获取到的新订阅链接并更新即可。'
  },
  {
    question: '在办公室或合租房，如何将电脑上的代理共享给同局域网的手机或 Switch？',
    answer: '在电脑端客户端（如 Clash Verge Rev）设置中开启“允许来自局域网的连接 (Allow LAN)”，并记录电脑在局域网中的内网 IP（如 192.168.1.100）及混合代理端口（默认通常为 7897 或 7890）；然后在手机或 Switch 的 Wi-Fi 高级设置中，将 HTTP 代理设置为“手动”，输入电脑的内网 IP 和对应端口即可共享分流。'
  }
];

const tocItems = [
  { id: 'answer-first', title: 'Answer-First 新手上手标准 5 步 SOP' },
  { id: 'security-principles', title: '前置准备与凭据安全合规红线' },
  { id: 'client-decision-tree', title: '全平台主流客户端选型判定树' },
  { id: 'sop-windows', title: 'Windows 平台配置实战：Clash Verge Rev' },
  { id: 'sop-android', title: 'Android 平台配置实战：Clash Meta / Sing-box' },
  { id: 'sop-ios', title: 'iOS 平台配置实战：Shadowrocket / Loon' },
  { id: 'sop-macos', title: 'macOS 平台配置实战：系统权限与内核托管' },
  { id: 'subscription-management', title: '订阅链接管理全景：导入、更新与防盗刷' },
  { id: 'proxy-modes', title: '三大代理模式拆解：Rule vs Global vs Direct' },
  { id: 'tun-vs-system-proxy', title: '系统代理 vs TUN 虚拟网卡：全面接管对比' },
  { id: 'fake-ip-dns', title: 'DNS 泄漏防护与 Fake-IP 工作原理' },
  { id: 'ruleset-customization', title: '规则集分流策略定制：GeoSite 与 GeoIP' },
  { id: 'lan-sharing', title: '局域网共享与多设备同享设置 (Switch/TV)' },
  { id: 'verification-sop', title: '配置验证与连通性验证标准化步骤' },
  { id: 'articles-directory', title: '核心教程图文专栏 (7篇实战手册)' },
  { id: 'faq', title: '高频常见问题 (FAQ)' },
  { id: 'next-steps', title: '关联排障与工具页面入口' }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} faqItems={faqItems} type="collection">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Hero Header -->
    <div class="mb-8 border-b border-brand-border pb-6">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-brand-teal text-xs font-semibold border border-emerald-200 mb-3">
        <span>📖 实战配置手册 · 合规安全使用</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">
        网络代理与客户端全平台使用教程：订阅导入、TUN 模式与规则分流
      </h1>
      <p class="text-sm sm:text-base text-brand-muted mt-3 leading-relaxed">
        面向合法学术科研、海外开发与跨国商务协作场景。本文提供从零开始的全平台标准配置指南，涵盖 Windows、macOS、Android 与 iOS 四大系统的开源客户端选择、订阅凭据安全管理、虚拟网卡接管与 DNS 防泄漏最佳实践。
      </p>
    </div>

    <!-- In-Page TOC Anchor Navigation -->
    <nav class="my-6 p-4 bg-brand-light border border-brand-border rounded-xl shadow-xs" aria-label="页面目录导航">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-brand-border text-xs font-bold text-brand-dark">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          本文核心教程目录 (TOC)
        </span>
        <span class="text-brand-muted font-normal">点击快速跳转</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-1.5 text-xs">
        {tocItems.map(item => (
          <a href={`#${item.id}`} class="text-brand-dark hover:text-brand-teal hover:underline truncate py-0.5">
            · {item.title}
          </a>
        ))}
      </div>
    </nav>

    <!-- MODULE 2: Answer-First Core Process Diagram -->
    <section id="answer-first" class="my-8 scroll-mt-20">
      <div class="p-5 bg-linear-to-br from-emerald-50/70 via-white to-blue-50/50 border-2 border-brand-teal/40 rounded-2xl shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2 py-0.5 rounded bg-brand-teal text-white text-xs font-bold tracking-wide">Answer-First 核心流程</span>
          <span class="text-xs text-brand-muted font-mono">新手上手标准 5 步闭环</span>
        </div>
        <h2 class="text-lg font-bold text-brand-dark mb-2">无论什么系统与客户端，通用的标准配置链条</h2>
        <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-4">
          所有现代代理客户端的操作逻辑本质完全一致，遵循以下 5 步即可在 3 分钟内完成从下载到安全上网的全流程：
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-2.5 text-xs">
          <div class="p-3 bg-white rounded-xl border border-brand-border shadow-2xs">
            <div class="font-bold text-brand-teal mb-1">步骤 1：下载客户端</div>
            <div class="text-brand-muted">从 GitHub 官方发布页下载对应系统的稳定发行版，切勿使用来源不明的打包修改版。</div>
          </div>
          <div class="p-3 bg-white rounded-xl border border-brand-border shadow-2xs">
            <div class="font-bold text-brand-teal mb-1">步骤 2：复制订阅地址</div>
            <div class="text-brand-muted">登录机场用户中心，复制专属的 Clash / Universal 订阅链接，妥善保管其中的 Token。</div>
          </div>
          <div class="p-3 bg-white rounded-xl border border-brand-border shadow-2xs">
            <div class="font-bold text-brand-teal mb-1">步骤 3：导入配置档案</div>
            <div class="text-brand-muted">在客户端“配置 (Profiles)”界面粘贴订阅 URL 并下载，解析出完整的节点集群与分流规则。</div>
          </div>
          <div class="p-3 bg-white rounded-xl border border-brand-border shadow-2xs">
            <div class="font-bold text-brand-teal mb-1">步骤 4：设定规则分流</div>
            <div class="text-brand-muted">将代理模式设为“规则 (Rule)”，并在代理组中手动指定一个低延迟的优质落地节点。</div>
          </div>
          <div class="p-3 bg-white rounded-xl border border-brand-border shadow-2xs">
            <div class="font-bold text-brand-teal mb-1">步骤 5：开启代理开关</div>
            <div class="text-brand-muted">开启“系统代理”或安装服务模式开启“TUN 模式”，并在浏览器验证实际生效的外部 IP。</div>
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE 3: Security & Principles Warning -->
    <section id="security-principles" class="my-8 scroll-mt-20">
      <div class="bg-amber-50/80 border-2 border-amber-300 rounded-xl p-5 text-xs text-amber-950 space-y-2 shadow-2xs">
        <div class="font-bold text-sm flex items-center gap-2 text-amber-900">
          <span>🔒 前置安全原则与网络合规防线</span>
        </div>
        <p class="leading-relaxed">
          <strong>1. 凭据保密：</strong>订阅链接包含您在服务端的鉴权凭证（Token）。严禁截图分享或直接粘贴至公开论坛，防止套餐被盗刷或引发多地并发封号。<br/>
          <strong>2. 保持安全防护：</strong>任何正规代理客户端均不需要用户关闭 Windows Defender、macOS Gatekeeper 或关闭系统防火墙。若某“客户端”强制要求关闭安全防护，必须立即停止使用并排查恶意木马。<br/>
          <strong>3. 合规使用：</strong>本指南仅适用于正规跨国学术研究、合规出海商务办公及正版流媒体娱乐场景，遵守所在地区法律法规。
        </p>
      </div>
    </section>

    <!-- MODULE 4: Client Selection Decision Tree -->
    <section id="client-decision-tree" class="my-10 scroll-mt-20 space-y-4">
      <h2 class="text-xl font-bold text-brand-dark border-l-4 border-brand-teal pl-3">
        全平台主流客户端选型判定树
      </h2>
      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
        根据您的操作系统、技术背景以及是否有特定场景需求（如电竞游戏或全屋路由），选择最契合的软件载体：
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs">
        <div class="p-4 bg-white border border-brand-border rounded-xl space-y-2 shadow-2xs">
          <div class="font-bold text-brand-dark text-sm flex items-center justify-between">
            <span>Windows 用户</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">首选</span>
          </div>
          <div class="text-brand-muted space-y-1">
            <p><strong>常规主力：</strong><a href="/clients/clash-verge-rev/" class="text-brand-teal hover:underline font-bold">Clash Verge Rev</a> (Mihomo 内核，现代化 UI，原生支持 TUN 虚拟网卡)</p>
            <p><strong>备选工具：</strong>v2rayN (经典多内核管理，适合高阶调试与自建 VPS)</p>
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl space-y-2 shadow-2xs">
          <div class="font-bold text-brand-dark text-sm flex items-center justify-between">
            <span>macOS 用户</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-bold">首选</span>
          </div>
          <div class="text-brand-muted space-y-1">
            <p><strong>常规主力：</strong><a href="/clients/clash-verge-rev/" class="text-brand-teal hover:underline font-bold">Clash Verge Rev Mac 版</a> (原生 Apple Silicon 支持，菜单栏常驻)</p>
            <p><strong>高阶专业：</strong>Surge for Mac (极度强大但收费昂贵的网络开发调试神器)</p>
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl space-y-2 shadow-2xs">
          <div class="font-bold text-brand-dark text-sm flex items-center justify-between">
            <span>Android 用户</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-100 text-purple-800 font-bold">首选</span>
          </div>
          <div class="text-brand-muted space-y-1">
            <p><strong>常规主力：</strong><a href="/clients/#platform-android" class="text-brand-teal hover:underline font-bold">Clash Meta for Android</a> (CMFA 开源维护版，分应用代理极佳)</p>
            <p><strong>现代轻量：</strong>Sing-box for Android (低内存占用与高并发支持)</p>
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl space-y-2 shadow-2xs">
          <div class="font-bold text-brand-dark text-sm flex items-center justify-between">
            <span>iOS / iPadOS 用户</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 font-bold">首选</span>
          </div>
          <div class="text-brand-muted space-y-1">
            <p><strong>性价比首选：</strong><a href="/clients/shadowrocket/" class="text-brand-teal hover:underline font-bold">Shadowrocket (小火箭)</a> ($2.99，功能全面稳定)</p>
            <p><strong>高阶质感：</strong>Loon ($5.99) 或 Quantumult X (精细化脚本支持)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE 5: Windows SOP -->
    <section id="sop-windows" class="my-10 scroll-mt-20 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-brand-border">
        <h2 class="text-xl font-bold text-brand-dark border-l-4 border-brand-teal pl-3">
          Windows 平台标准配置 SOP：Clash Verge Rev
        </h2>
        <span class="text-xs px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold">Win 10/11 验证通过</span>
      </div>
      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
        Clash Verge Rev 是当前 Windows 平台体验最完整、维护最活跃的开源客户端。请按照标准流程操作：
      </p>

      <div class="p-4 bg-white border border-brand-border rounded-xl space-y-3 text-xs">
        <ol class="list-decimal list-inside space-y-2.5 text-brand-dark leading-relaxed font-medium">
          <li>
            <strong>安装包获取与安装：</strong>前往本站 <a href="/clients/clash-verge-rev/" class="text-brand-teal hover:underline">Clash Verge Rev 官方专栏</a> 下载 <code>Clash.Verge_x64-setup.exe</code>，按照默认提示安装并允许防火墙通信。
          </li>
          <li>
            <strong>导入机场订阅：</strong>启动软件，点击左侧菜单栏的 <strong>“订阅 (Profiles)”</strong>。将机场后台复制的 Clash 订阅链接粘贴到顶部 URL 输入框中，点击 <strong>“保存 (Save)”</strong>。右键该配置卡片可设置自动更新间隔（建议设为 1440 分钟/每天）。
          </li>
          <li>
            <strong>激活配置档案：</strong>鼠标左键点击刚刚导入的配置卡片，边框变为高亮青绿色即表示该配置已生效。
          </li>
          <li>
            <strong>设置代理分流模式：</strong>点击左侧 <strong>“代理 (Proxies)”</strong> 菜单，确保顶部切换为 <strong>“规则 (Rule)”</strong> 模式；在策略组列表中，挑选一个低延迟的香港或日本节点作为日常主力。
          </li>
          <li>
            <strong>启动系统代理与 TUN：</strong>点击左侧 <strong>“设置 (Settings)”</strong>，打开 <strong>“系统代理 (System Proxy)”</strong> 开关即可正常上网。若需玩外服游戏或让命令行终端走代理，可点击“服务模式 (Service Mode)”右侧安装按钮，随后开启 <strong>“TUN 模式”</strong>。
          </li>
        </ol>
      </div>
    </section>

    <!-- MODULE 6: Android SOP -->
    <section id="sop-android" class="my-10 scroll-mt-20 space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-brand-border">
        <h2 class="text-xl font-bold text-brand-dark border-l-4 border-brand-teal pl-3">
          Android 平台标准配置 SOP：Clash Meta for Android
        </h2>
        <span class="text-xs px-2 py-0.5 rounded bg-purple-100 text-purple-800 font-bold">原生系统与国产定制 ROM 兼容</span>
      </div>
      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
        在 Android 平台推荐使用社区维护的开源分支 Clash Meta for Android (CMFA)：
      </p>

      <div class="p-4 bg-white border border-brand-border rounded-xl space-y-3 text-xs">
        <ol class="list-decimal list-inside space-y-2.5 text-brand-dark leading-relaxed font-medium">
          <li>
            <strong>安装 APK：</strong>下载最新版 <code>cmfa-*-universal-release.apk</code> 完成安装。小米/OPPO/vivo 等系统请在系统设置中为软件授予<strong>“无限制后台运行”</strong>权限，防止被系统杀后台。
          </li>
          <li>
