---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import FAQ from '../../components/FAQ.astro';
import { BRANDS } from '../../data/brands';

const title = '2026 机场价格与套餐对比指南 · 便宜机场、一元机场真相与性价比全景对比';
const description = '权威透明的 2026 机场价格与资费对比专题。深度拆解 5.6 元极限平价档、10–25 元主流性价比档、大容量月付与一次性不限时流量包的真实单价，严谨澄清一元机场套路，拒绝虚构低价。';
const breadcrumbs = [
  { name: '价格与套餐', url: '/pricing/' }
];

// Flat plans with brand metadata
const allPlans = BRANDS.flatMap(b => b.plans.map(p => ({
  ...p,
  brandName: b.name,
  brandSlug: b.slug,
  brandIsPartner: b.isPartner,
  networkType: b.networkType,
  supportsClash: b.clientSupport.supportsClash
})));

// Tiers
const ultraCheapPlans = allPlans.filter(p => p.monthlyEquivalentYuan <= 10).sort((a,b) => a.monthlyEquivalentYuan - b.monthlyEquivalentYuan);
const midTierPlans = allPlans.filter(p => p.monthlyEquivalentYuan > 10 && p.monthlyEquivalentYuan <= 25).sort((a,b) => a.monthlyEquivalentYuan - b.monthlyEquivalentYuan);
const highTierPlans = allPlans.filter(p => p.monthlyEquivalentYuan > 25).sort((a,b) => a.monthlyEquivalentYuan - b.monthlyEquivalentYuan);
const oneTimePlans = allPlans.filter(p => p.resetPolicy === 'oneTime').sort((a,b) => a.priceYuan - b.priceYuan);

const faqItems = [
  {
    question: '网上传言的“一元机场”或“一分机场”真的存在吗？靠谱吗？',
    answer: '经我们对数十家服务商及历史公开资料库的交叉审计，并未找到任何一家能够提供正规商业 IEPL 专线且持续稳定运营的“真正一元/月”机场。市面上所谓的“一元机场”，绝大多数是利用公网免费中继、白嫖云服务试用金或短命超卖盘搭设的临时节点，往往几天内大面积失联或直接跑路关停。正规专线存在高昂的跨境物理光缆采购硬成本，用户不应抱有“一元享专线”的非理性预期。'
  },
  {
    question: '为什么很多宣传“5.6 元/月”的套餐要求一次性付一年？',
    answer: '这是行业常见的价格折算营销套路。服务商将年付 67.2 元除以 12 个月得出 5.6 元/月的数字。这种套餐不支持按月扣款，必须一次性缴清全款。购买此类套餐需重点评估该服务商是否能稳定履约一整年，防范年付中途服务中断导致的沉没成本。'
  },
  {
    question: '一次性不限时套餐和按月重置套餐哪个更划算？',
    answer: '取决于您的消耗速度。按月重置套餐的每 GB 成本通常较低（约 ¥0.1 - ¥0.3/GB），适合每月有持续上网需求的主力用户；而一次性不过期套餐的每 GB 单价普遍较贵（约 ¥0.6 - ¥1.5/GB），但没有每个月扣月租的清零压力，非常适合作为备用应急、偶尔查资料的用户。'
  },
  {
    question: '如何理解“节点倍率”对实际价格的放大效应？',
    answer: '节点倍率是隐性计费放大器。例如购买了 100GB 套餐，连接 1.0x 节点下载 10GB 扣除 10GB；若连接 2.0x 节点（如某些商宽或高级节点），下载 10GB 会被实际扣除 20GB，等同于套餐实际可用容量减半、实际单位 GB 成本翻倍。在比较价格时，必须结合节点倍率综合评估。'
  },
  {
    question: '新手买小流量套餐（如 50GB/月）够用吗？',
    answer: '若仅用于日常文字查资料、学术检索、代码同步以及 ChatGPT 对话，50GB/月绰绰有余（文字网页单次消耗仅数 MB）。但若用于观看 YouTube 1080P/4K 或刷 TikTok 短视频，每小时消耗约 2–7GB，50GB 仅能支撑 10–20 小时。'
  },
  {
    question: '为什么有的机场年付折扣很大（如年付 6 折），能买吗？',
    answer: '老牌且稳定运营 3 年以上的品牌推出年付 7–8 折通常属于正常的资金回笼手段；但若运营不足 1 年的新品牌突然推出“年付 2 折”或“买一年送两年”，极大概率是资金链断裂前夕的最后一波吸资卷款，风险极高。'
  },
  {
    question: '优惠码一般有哪些使用限制？',
    answer: '常见限制包括：仅限新用户首单优惠、仅适用于年付或半年付套餐、月付续费无效、或设有最低消费门槛。结算时需留意折扣后实际扣款金额。'
  },
  {
    question: '买大套餐划算还是买小套餐加流量包划算？',
    answer: '如果日常消耗平稳，直接按月购买对应容量的主力套餐最经济；如果仅在特定月份（如假期追剧、海外出差）有突发大流量需求，平时购买小额基础月付、临时叠加流量包可避免长期闲置浪费。'
  }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} faqItems={faqItems} type="collection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    
    <!-- Hero Header with Answer-First Summary -->
    <header class="border-b border-brand-border pb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-brand-teal text-xs font-semibold border border-emerald-200 mb-4">
        <span>💰 价格大盘 · 透明算账 · 拒绝虚假标价</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
        2026 机场价格档位与资费全景对比
      </h1>
      <p class="text-sm sm:text-base text-brand-muted mt-3 max-w-4xl leading-relaxed">
        告别文字游戏与隐藏陷阱。本专题对 31 家主流服务商的数千档套餐进行结构化拆解：严格区分真实月付、年付总额、折算单月成本与一次性流量包，测算单位 GB 真实支出，帮助您花最少的钱获得最稳的网络体验。
      </p>

      <!-- Quick Answer Summary Box (GEO / AI Overviews Optimized) -->
      <div class="mt-6 p-5 bg-white border border-brand-teal/40 rounded-2xl shadow-sm bg-gradient-to-r from-emerald-50/40 to-transparent">
        <div class="text-xs font-bold text-brand-teal uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span>⚡ 套餐选购核心结论速览 (Answer-First)</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-brand-dark">
          <div class="p-3 bg-white/80 rounded-xl border border-brand-border space-y-1">
            <span class="font-bold text-emerald-800 block">最划算的主力档 (¥15–¥25/月)</span>
            <p class="text-brand-muted">专线月流量 100GB–200GB，每 GB 成本仅约 ¥0.1–¥0.15。晚高峰抗抖动看 4K 与日常办公两不误，是绝大多数用户的黄金甜点区。</p>
          </div>
          <div class="p-3 bg-white/80 rounded-xl border border-brand-border space-y-1">
            <span class="font-bold text-blue-800 block">最佳备用容灾方案 (一次性不限时)</span>
            <p class="text-brand-muted">一次性花费 ¥15–¥30 购买 100GB–300GB 不限时流量包。零月租压力、流量永久待命，主力专线故障时无缝顶上。</p>
          </div>
          <div class="p-3 bg-white/80 rounded-xl border border-brand-border space-y-1">
            <span class="font-bold text-rose-800 block">坚决规避的陷阱 (虚假一元/终身卡)</span>
            <p class="text-brand-muted">不存在能长期稳定提供 IEPL 专线的“1元/月”或“终身卡”服务。反常识超低价必伴随万人挤占、高倍率暗扣或随时跑路卷款。</p>
          </div>
        </div>
      </div>
    </header>

    <!-- In-Page Table of Contents -->
    <nav class="bg-brand-light p-5 rounded-2xl border border-brand-border text-xs">
      <span class="font-bold text-brand-dark block mb-3 text-sm flex items-center gap-2">
        <span>📑 价格专题深度导航 (快速跳转)</span>
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 text-brand-muted">
        <a href="#sec-truth-1yuan" class="hover:text-brand-teal hover:underline">一、一元与一分机场的行业真相</a>
        <a href="#sec-tier-cheap" class="hover:text-brand-teal hover:underline">二、极限平价档 (月均折算 ≤ ¥10)</a>
        <a href="#sec-tier-mainstream" class="hover:text-brand-teal hover:underline">三、主流性价比档 (¥10 – ¥25/月)</a>
        <a href="#sec-tier-premium" class="hover:text-brand-teal hover:underline">四、高端旗舰商务档 (¥25/月以上)</a>
        <a href="#sec-tier-onetime" class="hover:text-brand-teal hover:underline">五、一次性不限时不过期流量包</a>
        <a href="#sec-monthly-vs-yearly" class="hover:text-brand-teal hover:underline">六、月付与年付深度经济学对比</a>
        <a href="#sec-unit-cost" class="hover:text-brand-teal hover:underline">七、单位 GB 真实流量成本天梯</a>
        <a href="#sec-multiplier-effect" class="hover:text-brand-teal hover:underline">八、高倍率节点对实际扣费的影响</a>
        <a href="#sec-traffic-demands" class="hover:text-brand-teal hover:underline">九、小流量 vs 大流量套餐选型</a>
        <a href="#sec-device-limits" class="hover:text-brand-teal hover:underline">十、设备并发限制与家庭共享</a>
        <a href="#sec-coupons" class="hover:text-brand-teal hover:underline">十一、优惠码使用规则与核验</a>
        <a href="#sec-hidden-costs" class="hover:text-brand-teal hover:underline">十二、五项隐性成本防坑检查</a>
        <a href="#sec-faqs" class="hover:text-brand-teal hover:underline">十三、价格与资费高频问答 FAQ</a>
      </div>
    </nav>

    <!-- Secondary Topic Hubs (二级价格细分专题导航) -->
    <section class="p-5 bg-white border border-brand-border rounded-2xl shadow-xs space-y-3">
      <div class="flex items-center justify-between pb-2 border-b border-brand-border">
        <h2 class="text-sm font-bold text-brand-dark flex items-center gap-1.5">
          <span>🎯 二级价格细分专题与精算决策中心</span>
        </h2>
        <span class="text-xs text-brand-muted">按预算与计费方式精准直达</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-xs">
        <a href="/pricing/cheap/" class="p-3 bg-brand-light rounded-xl border border-brand-border hover:border-brand-teal transition block text-center group">
          <div class="font-bold text-brand-dark group-hover:text-brand-teal mb-0.5">🏷️ 便宜机场推荐</div>
          <div class="text-[11px] text-brand-muted">10元以内平价备用</div>
        </a>
        <a href="/pricing/1-yuan/" class="p-3 bg-brand-light rounded-xl border border-brand-border hover:border-brand-teal transition block text-center group">
          <div class="font-bold text-brand-dark group-hover:text-brand-teal mb-0.5">🔍 一元机场真相</div>
          <div class="text-[11px] text-brand-muted">超卖套路深度解构</div>
        </a>
        <a href="/pricing/monthly/" class="p-3 bg-brand-light rounded-xl border border-brand-border hover:border-brand-teal transition block text-center group">
          <div class="font-bold text-brand-dark group-hover:text-brand-teal mb-0.5">🔄 灵活月付精选</div>
          <div class="text-[11px] text-brand-muted">零合约负担防跑路</div>
        </a>
        <a href="/pricing/non-expiring/" class="p-3 bg-brand-light rounded-xl border border-brand-border hover:border-brand-teal transition block text-center group">
          <div class="font-bold text-brand-dark group-hover:text-brand-teal mb-0.5">⏳ 不限时不过期</div>
          <div class="text-[11px] text-brand-muted">永久流量长效待命</div>
        </a>
        <a href="/pricing/cost-performance/" class="p-3 bg-brand-light rounded-xl border border-brand-border hover:border-brand-teal transition block text-center group">
          <div class="font-bold text-brand-dark group-hover:text-brand-teal mb-0.5">🧮 流量单价精算</div>
          <div class="text-[11px] text-brand-muted">每GB成本天梯对比</div>
        </a>
      </div>
    </section>

    <AffiliateDisclosure />

    <!-- SECTION 1: TRUTH ABOUT 1-YUAN & 1-CENT AIRPORTS -->
    <section id="sec-truth-1yuan" class="space-y-4 scroll-mt-20">
      <div class="bg-rose-50 border border-rose-200 rounded-2xl p-6 text-xs text-rose-950 space-y-3 shadow-sm">
        <div class="font-bold text-base text-rose-900 flex items-center gap-2">
          <span>🚨 关于“一元机场 / 一分机场”的行业技术真相与风险剖析</span>
        </div>
        <p class="leading-relaxed text-rose-950/90">
          搜索引擎与社媒中存在海量关于“一元机场”、“一分钱机场”的讨论。作为独立客观的技术平台，我们必须向用户澄清其背后的真实商业与技术模型：
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="p-3.5 bg-white/80 rounded-xl border border-rose-200 space-y-1.5">
            <span class="font-bold text-rose-900 block text-sm">1. 物理成本的不可抗拒性</span>
            <p class="text-rose-950/80">
              正规电信运营商的企业跨境专线（IEPL/IPLC）每 1Gbps 带宽月租成本高达数千至上万元。若按 1 元/月定价，1000 个用户仅能收取 1000 元，连机房电费和最廉价的公网入口服务器都无法覆盖。
            </p>
          </div>
          <div class="p-3.5 bg-white/80 rounded-xl border border-rose-200 space-y-1.5">
            <span class="font-bold text-rose-900 block text-sm">2. 实际运作套路与安全隐患</span>
            <p class="text-rose-950/80">
              市场上宣称一元的平台通常采用：① 免费白嫖云厂商临时新手试用金，用完即弃；② 严重超售（把 5000 人塞进 100Mbps 共享公网）；③ 后台暗设 5x–10x 高倍率扣量；④ 收集用户邮箱与密码凭据的羊毛盘甚至钓鱼盘。
            </p>
          </div>
        </div>
        <div class="p-3 bg-rose-100/70 rounded-lg text-rose-950 font-medium">
          <strong>结论：</strong>本站数据库严格遵循真实可信原则，<strong>绝不收录任何虚构的“一元正规专线”</strong>。若预算极度紧张，推荐选择 ¥5.6–¥8 档经受住市场检验的平价老牌服务商，而不是随时失联的一元羊毛盘。
        </div>
      </div>
    </section>

    <!-- SECTION 2: TIER 1 - ULTRA CHEAP <= 10 YUAN -->
    <section id="sec-tier-cheap" class="space-y-4 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-brand-border pb-3 gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
            <span>🟢 梯队一：极限平价档 (月均折算 ≤ ¥10/月)</span>
          </h2>
          <p class="text-xs text-brand-muted mt-0.5">
            以 5.6 元至 8 元档年付折算小包为主，流量普遍在 45GB–70GB/月，适合轻量查阅与备用
          </p>
        </div>
        <span class="text-xs text-brand-muted font-mono">共收录 {ultraCheapPlans.length} 档已核验套餐</span>
      </div>

      <div class="overflow-x-auto bg-white border border-brand-border rounded-xl shadow-sm">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-brand-light border-b border-brand-border text-brand-dark font-bold">
              <th class="p-3 whitespace-nowrap">品牌 / 套餐规格</th>
              <th class="p-3 whitespace-nowrap">真实付款方式</th>
              <th class="p-3 whitespace-nowrap font-mono">总付款金额</th>
              <th class="p-3 whitespace-nowrap font-mono">折算月均单价</th>
              <th class="p-3 whitespace-nowrap font-mono">每月流量</th>
              <th class="p-3 whitespace-nowrap font-mono">单位成本 (~/GB)</th>
              <th class="p-3 whitespace-nowrap">线路架构</th>
              <th class="p-3 whitespace-nowrap">Clash 支持</th>
              <th class="p-3 whitespace-nowrap">操作</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-border text-brand-muted font-sans">
            {ultraCheapPlans.map(p => {
              const perGb = (p.monthlyEquivalentYuan / p.trafficGB).toFixed(2);
              return (
                <tr class="hover:bg-brand-light/60 transition">
                  <td class="p-3 font-bold text-brand-dark whitespace-nowrap">
                    <a href={`/brands/${p.brandSlug}/`} class="text-brand-teal hover:underline flex items-center gap-1">
                      <span>{p.brandName}</span>
                      {p.brandIsPartner && <span class="text-[9px] bg-emerald-100 text-emerald-800 px-1 py-0.2 rounded font-normal">合作展示</span>}
                    </a>
                    <div class="text-[11px] text-brand-muted font-normal mt-0.5">{p.name}</div>
                  </td>
                  <td class="p-3 whitespace-nowrap">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-semibold ${p.billingCycle === 'yearly' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}`}>
                      {p.billingCycle === 'yearly' ? '年付交清' : '按月扣款'}
                    </span>
                  </td>
                  <td class="p-3 font-mono font-bold text-brand-dark whitespace-nowrap">¥{p.priceYuan}</td>
                  <td class="p-3 font-mono whitespace-nowrap">
                    <strong class="text-brand-teal text-sm">¥{p.monthlyEquivalentYuan}</strong>
                    <span class="text-gray-400 font-normal">/月</span>
                  </td>
                  <td class="p-3 font-mono font-bold text-brand-dark whitespace-nowrap">{p.trafficGB} GB</td>
                  <td class="p-3 font-mono whitespace-nowrap">¥{perGb}</td>
                  <td class="p-3 whitespace-nowrap">{p.networkType} 专线</td>
                  <td class="p-3 whitespace-nowrap">
                    <span class={`text-[10px] px-1.5 py-0.5 rounded border ${p.supportsClash ? 'bg-blue-50 text-blue-700 border-blue-200' : 'bg-gray-100 text-gray-600 border-gray-200'}`}>
                      {p.supportsClash ? '通用订阅' : '专属客户端'}
                    </span>
                  </td>
                  <td class="p-3 whitespace-nowrap">
                    <a href={`/brands/${p.brandSlug}/`} class="text-brand-teal hover:underline font-bold text-[11px]">详细档案 →</a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- SECTION 3: TIER 2 - MAINSTREAM 10 - 25 YUAN -->
    <section id="sec-tier-mainstream" class="space-y-4 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-brand-border pb-3 gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
            <span>🔵 梯队二：主流高性价比档 (¥10 – ¥25/月 · 推荐主力区)</span>
          </h2>
          <p class="text-xs text-brand-muted mt-0.5">
            绝大多数普通用户的最佳黄金甜点区。月流量 100GB–250GB，真实 IEPL 专线，晚高峰看 4K 流畅稳定
          </p>
        </div>
        <span class="text-xs text-brand-muted font-mono">共收录 {midTierPlans.length} 档已核验套餐</span>
      </div>

      <div class="overflow-x-auto bg-white border border-brand-border rounded-xl shadow-sm">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-brand-light border-b border-brand-border text-brand-dark font-bold">
              <th class="p-3 whitespace-nowrap">品牌 / 套餐规格</th>
