    <!-- MODULE 9: Throughput, Bandwidth & Video Bitrates -->
    <section id="throughput-metrics" class="my-10 scroll-mt-20 space-y-4">
      <h2 class="text-xl font-bold text-brand-dark border-l-4 border-brand-teal pl-3">
