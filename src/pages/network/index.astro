---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NetworkConceptDiagram from '../../components/NetworkConceptDiagram.astro';
import FAQ from '../../components/FAQ.astro';
import { BRANDS } from '../../data/brands';

const title = '机场线路与节点全景指南 · IEPL、IPLC 专线与 BGP 中转架构深度科普';
const description = '深度剖析机场网络底层架构。权威解析 IEPL 国际以太网专线、IPLC 专线与 BGP 隧道中转的技术差异，物理光纤时延极限、节点倍率计费模型、原生住宅 IP 识别与晚高峰测速防坑 SOP。';
const breadcrumbs = [
  { name: '线路与节点', url: '/network/' }
];

const faqItems = [
  {
    question: 'IEPL 专线和 IPLC 专线到底有什么区别？哪个更好？',
    answer: '在最终用户的实际体验上，两者表现高度接近。IPLC（International Private Leased Circuit，国际专线租用电路）是电信运营商最早期的点对点物理内网专线标准；IEPL（International Ethernet Private Line，国际以太网私线）则是基于现代以太网技术的二层虚拟专线，具备更灵活的带宽调度能力与配置灵活性。两者的核心共同点是：均在运营商骨干内网闭环中完成跨过境传输，完全绕过公网国际出口路由与防火墙过滤，因此晚高峰极其平稳，几乎不受公网拥塞波动影响。'
  },
  {
    question: '为什么美国节点的延迟通常在 130ms–180ms 甚至更高？这是质量差吗？',
    answer: '完全不是质量差，而是受限于光速传播的物理定律。中国大陆到美国本土横跨太平洋，物理直线距离超过 10,000 公里。光在海底石英玻璃光纤中的折射率导致每传输 1,000 公里产生约 5ms 的单向时延，往返（RTT）仅纯物理光纤耗时就至少需要 100ms 以上，加上国内骨干网接入跳数与美国机房路由交换，130ms–160ms 已经是跨太平洋的物理顶级水准。如果有服务商宣传“美国节点 20ms”，必属将本地到国内中转入口的握手延迟冒充最终落地延迟的虚假宣传。'
  },
  {
    question: '什么是“节点倍率”？为什么用 2 倍率节点流量扣得飞快？',
    answer: '节点倍率是服务商对不同采购成本节点设定的计费放大系数。1.0x 倍率表示您下载 1GB 视频就扣除 1GB 套餐流量；若使用 2.0x 倍率节点（通常是昂贵的高级专线或原生住宅 IP），下载 1GB 实际将扣除 2GB 套餐配额；反之 0.2x 倍率节点下载 1GB 只扣 0.2GB。用户在客户端连接前务必看清节点名称中的倍率标注，避免误用高倍率导致流量快速见底。'
  },
  {
    question: '为什么有时中转节点白天飞快，晚上 20:00–23:00 会严重卡顿甚至断连？',
    answer: '普通公网中转或劣质隧道中转依赖公网 IP 进行国内到境外的中继。每天晚高峰时期（20:00–23:00），国际公网出口带宽发生严重拥塞，运营商 QoS 策略会优先丢弃普通 UDP 与 TCP 流量，造成丢包率从 0.5% 骤升至 15%–30%，TCP 窗口骤降导致吞吐断崖式下跌。而真正的 IEPL/IPLC 专线走内网 SLA 保障链路，不经过公网出口，因此可以做到 24 小时全天候无波动。'
  },
  {
    question: '什么是 BGP 多线入口？它相比单线中转有什么优势？',
    answer: 'BGP（Border Gateway Protocol，边界网关协议）多线入口是指服务商在国内接入了同时拥有中国电信、中国联通、中国移动等多个运营商对等互联的机房。不同宽带的用户在发起连接时，BGP 路由器会自动根据网络自治域（AS）拓扑匹配最优接入链路，避免了“电信用户跨网连移动入口”引发的高跨网延迟与丢包，且在单条运营商光纤故障时具备毫秒级自动容灾切换能力。'
  },
  {
    question: '为什么客户端节点列表显示的 Ping 延迟很低（如 15ms），但打开网页依然很慢？',
    answer: '这是新手最容易踩的陷阱。大部分客户端（如 Clash、v2rayN）默认执行的 Ping 测速，测试的仅是“本地电脑到服务商国内入口服务器”的握手延迟（TCP Handshake），而不是“到境外目标网站”的端到端真实 RTT。如果服务商国内入口在本地同城，Ping 延迟自然只有十几毫秒；但如果其过境带宽已经严重拥堵，境外端到端延迟可能高达几百毫秒甚至丢包，因此切勿将客户端内的入口 Ping 当作实际网速。'
  },
  {
    question: '原生 IP 与广播机房 IP 对日常使用有什么实际影响？',
    answer: '广播 IP（Datacenter IP）是机房大批量向互联网注册机构宣告的商用 IP 段，被 Netflix、Disney+、ChatGPT、TikTok 等风控系统高度标记，容易遭遇 403 阻断、Cloudflare 5秒盾验证码死循环或被判定为机器人；原生住宅 IP（Residential IP）是当地民用宽带分配的真实用户 IP，信誉评级极高，能够完美通过各类风控系统，但成本高昂且多以高倍率呈现。'
  },
  {
    question: '日常使用为什么强烈建议关闭客户端的“自动选择（URL-Test）”策略？',
    answer: '自动选择策略会定期向测速 URL 发送探测包，并将流量切向响应延迟最小的节点。这会导致两个严重后果：第一，频繁切换节点导致外部 IP 不断变更，极易触发 Google、ChatGPT、银行等账号的安全异地风控甚至导致封号；第二，部分服务商的劣质节点或高倍率节点延迟短暂变低，自动切换会将流量导向这些高扣量节点，造成流量偷跑。推荐手动指定 1–2 个主力稳定节点。'
  }
];

const tocItems = [
  { id: 'answer-first', title: 'Answer-First 核心决策摘要与选点口诀' },
  { id: 'three-tier-arch', title: '机场网络技术底座：入口、过境与落地三层解耦' },
  { id: 'iepl-vs-iplc', title: 'IEPL 与 IPLC 物理专线深度剖析：不过墙的物理真相' },
  { id: 'bgp-relay', title: 'BGP 智能隧道中转架构：多线容灾与加密中继' },
  { id: 'direct-lines', title: '普通公网直连与精品网剖析：CN2 GIA、9929 与 4837' },
  { id: 'regional-guide', title: '热门国家与地区节点特性深度图谱 (港/日/新/美/台/欧)' },
  { id: 'physical-latency', title: '物理光纤极限与真实网络延迟对照表 (RTT 判定标准)' },
  { id: 'throughput-metrics', title: '带宽、吞吐与峰值速率：4K/8K 码率判定' },
  { id: 'packet-loss-jitter', title: '丢包率与抖动量化影响：为什么 1% 丢包能毁掉体验' },
  { id: 'rate-multipliers', title: '节点流量倍率机制与计算模型：防偷跑避坑指南' },
  { id: 'residential-vs-datacenter', title: '机房 IP 与原生/住宅 IP：风控等级与溯源技巧' },
  { id: 'speedtest-reading', title: '测速图与连通性看图指南：真吞吐 vs 虚假握手' },
  { id: 'evening-peak-sop', title: '晚高峰性能测试 SOP：标准化压测步骤' },
  { id: 'node-selection-rules', title: '科学选点避坑规则：为什么禁用自动选择' },
  { id: 'brand-line-matrix', title: '31 家主流品牌线路架构分布速查表' },
  { id: 'articles-directory', title: '线路网络核心科普专栏 (4篇深度解析)' },
  { id: 'faq', title: '高频常见问题 (FAQ)' },
  { id: 'next-steps', title: '下一代网络规划与关联工具' }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} faqItems={faqItems} type="collection">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Hero Header -->
    <div class="mb-8 border-b border-brand-border pb-6">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 text-brand-info text-xs font-semibold border border-blue-200 mb-3">
        <span>🌐 物理网络可观测性 · 硬核架构剖析</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">
        线路与节点架构全景指南：IEPL、IPLC 专线与 BGP 中转原理深度解析
      </h1>
      <p class="text-sm sm:text-base text-brand-muted mt-3 leading-relaxed">
        彻底告别服务商吹捧的虚假营销词汇。本页面基于网络工程物理层与传输层原理，详细拆解入口、过境与落地的三段式网络拓扑，用光速物理极限验明真实时延边界，解析节点倍率偷跑套路与晚高峰网络抗波动表现。
      </p>
    </div>

    <!-- In-Page TOC Anchor Navigation -->
    <nav class="my-6 p-4 bg-brand-light border border-brand-border rounded-xl shadow-xs" aria-label="页面目录导航">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-brand-border text-xs font-bold text-brand-dark">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          本文核心章节目录 (TOC)
        </span>
        <span class="text-brand-muted font-normal">点击快速跳转</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-1.5 text-xs">
        {tocItems.map(item => (
          <a href={`#${item.id}`} class="text-brand-dark hover:text-brand-teal hover:underline truncate py-0.5">
            · {item.title}
          </a>
        ))}
      </div>
    </nav>

    <!-- MODULE 2: Answer-First Core Decision Card -->
    <section id="answer-first" class="my-8 scroll-mt-20">
      <div class="p-5 bg-linear-to-br from-emerald-50/70 via-white to-blue-50/50 border-2 border-brand-teal/40 rounded-2xl shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <span class="px-2 py-0.5 rounded bg-brand-teal text-white text-xs font-bold tracking-wide">Answer-First 核心结论</span>
          <span class="text-xs text-brand-muted font-mono">网络决策黄金法则</span>
        </div>
        <h2 class="text-lg font-bold text-brand-dark mb-2">30秒掌握线路选购核心逻辑与选点口诀</h2>
        <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-4">
          现代代理网络的服务质量（QoS）90% 决定于<strong>过境链路</strong>的物理属性，而非客户端软件。专线保稳定、中转保性价、直连碰运气。请牢记以下选购与选点黄金法则：
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs mb-4">
          <div class="p-3 bg-white rounded-xl border border-emerald-200">
            <div class="font-bold text-emerald-800 mb-1">⚡ IEPL / IPLC 内网专线</div>
            <div class="text-brand-muted">物理专线内网传输，完全不过公网国际出口，晚高峰零丢包、抗波动能力极强，生产力与游戏核心首选。</div>
          </div>
          <div class="p-3 bg-white rounded-xl border border-blue-200">
            <div class="font-bold text-brand-info mb-1">🔄 BGP 多线隧道中转</div>
            <div class="text-brand-muted">国内三网 BGP 接入机房，通过加密隧道跨公网转发，带宽大成本低，性价比极高，但晚高峰可能偶有抖动。</div>
          </div>
          <div class="p-3 bg-white rounded-xl border border-amber-200">
            <div class="font-bold text-amber-800 mb-1">🌐 普通公网直连</div>
            <div class="text-brand-muted">本地客户端直连境外机房，无国内中继缓冲，晚高峰受国际海缆拥堵和 QoS 限制，丢包率往往超过 15%。</div>
          </div>
        </div>
        <div class="p-3 bg-emerald-100/60 rounded-xl border border-emerald-200 text-xs font-mono text-emerald-950 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <span>🎯 <strong>日常选点核心口诀：</strong>近用港新低延迟、影看日美全码率、AI 避港选美新、专线稳如磐石在、倍率先看防偷跑。</span>
          <a href="/recommend/" class="shrink-0 text-brand-teal hover:underline font-bold">查看专线推荐机场 →</a>
        </div>
      </div>
    </section>

    <!-- Network Topology Interactive Component -->
    <section class="my-8">
      <div class="pb-2 border-b border-brand-border mb-4">
        <h2 class="text-lg font-bold text-brand-dark">通用企业级专线与中转网络物理拓扑示意</h2>
        <p class="text-xs text-brand-muted mt-1">直观对比国内接入点、跨国过境链路与境外落地服务器的端到端数据流向。</p>
      </div>
      <NetworkConceptDiagram brandName="通用企业级专线与中转" networkType="IEPL / IPLC 物理专线" isSpecific={false} />
    </section>

    <!-- MODULE 3: Three-Tier Architecture -->
    <section id="three-tier-arch" class="my-10 scroll-mt-20 space-y-4">
      <h2 class="text-xl font-bold text-brand-dark border-l-4 border-brand-teal pl-3">
        机场网络技术底座：入口、过境与落地三层解耦
      </h2>
      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
        一个完整的代理链路绝非一根简单的“网线”，而是由地理位置完全不同的三段基础设施串联构成的分布式传输系统。理解这三层的分工，是避开 90% 虚假宣传的前提：
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center text-xs">1</span>
            <span class="font-bold text-brand-dark text-sm">入口层 (Ingress)</span>
          </div>
          <div class="text-brand-muted space-y-2 leading-relaxed">
            <p><strong>物理位置：</strong>中国大陆境内机房（常见于深圳、广州、上海、北京）。</p>
            <p><strong>核心职能：</strong>接收本地客户端的初次连接。负责本地运营商的接入适配，将电信、联通、移动宽带用户的流量汇聚到边界路由器。</p>
            <p><strong>技术指标：</strong>BGP 多线互联能力、入口带宽冗余、单线崩溃自动故障转移（Failover）。</p>
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-6 h-6 rounded-full bg-blue-100 text-brand-info font-bold flex items-center justify-center text-xs">2</span>
            <span class="font-bold text-brand-dark text-sm">过境层 (Transit)</span>
          </div>
          <div class="text-brand-muted space-y-2 leading-relaxed">
            <p><strong>物理位置：</strong>跨境传输通道（陆缆如深港专线、海缆如亚太环球光缆）。</p>
            <p><strong>核心职能：</strong>将数据从国内入口机房跨越地理国界传输至境外对端机房。这是整个服务链中<strong>成本最高、技术门槛最高</strong>的环节。</p>
            <p><strong>技术分类：</strong>IEPL 物理二层以太网专线、IPLC 点对点电路、BGP 公网加密隧道、普通公网直连。</p>
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-6 h-6 rounded-full bg-purple-100 text-purple-800 font-bold flex items-center justify-center text-xs">3</span>
            <span class="font-bold text-brand-dark text-sm">落地层 (Egress)</span>
          </div>
          <div class="text-brand-muted space-y-2 leading-relaxed">
            <p><strong>物理位置：</strong>目标国家/地区的境外数据中心（香港、东京、新加坡、洛杉矶等）。</p>
            <p><strong>核心职能：</strong>解密代理协议包，以当地真实的公网 IP 向目标网站（如 Google、Netflix、OpenAI）发起最终 TCP/UDP 握手并回传响应。</p>
            <p><strong>技术指标：</strong>IP 纯净度、原生住宅属性、解锁能力、出口互联带宽（Transit/IX）。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MODULE 4: IEPL vs IPLC Deep-Dive -->
    <section id="iepl-vs-iplc" class="my-10 scroll-mt-20 space-y-4">
      <h2 class="text-xl font-bold text-brand-dark border-l-4 border-brand-teal pl-3">
        IEPL 与 IPLC 物理专线深度剖析：不过墙的物理真相
      </h2>
      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
        “专线”是高端机场最具溢价能力的核心卖点。许多用户只知专线稳定，却不知其背后的通信工程逻辑：
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse border border-brand-border bg-white rounded-xl shadow-xs">
          <thead>
            <tr class="bg-brand-light text-brand-dark font-bold border-b border-brand-border">
              <th class="p-3">对比维度</th>
              <th class="p-3">IEPL (国际以太网私线)</th>
              <th class="p-3">IPLC (国际专线租用电路)</th>
              <th class="p-3">BGP 隧道中转 (普通中继)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-brand-border text-brand-muted">
            <tr class="hover:bg-brand-light/50">
              <td class="p-3 font-bold text-brand-dark">OSI 网络模型层次</td>
              <td class="p-3 text-emerald-800 font-mono">Layer 2 (数据链路层以太网)</td>
              <td class="p-3 text-blue-800 font-mono">Layer 1 (物理层时分复用 TDM)</td>
              <td class="p-3 font-mono">Layer 3/4/7 (公网 IP 封包转发)</td>
            </tr>
            <tr class="hover:bg-brand-light/50">
              <td class="p-3 font-bold text-brand-dark">是否经过公网出口</td>
              <td class="p-3 text-emerald-700 font-bold">完全不经过 (运营商内网点对点)</td>
              <td class="p-3 text-emerald-700 font-bold">完全不经过 (物理硬切片)</td>
              <td class="p-3 text-amber-700">经过公网 (通过公网加密传输)</td>
            </tr>
            <tr class="hover:bg-brand-light/50">
              <td class="p-3 font-bold text-brand-dark">防火墙审查与阻断</td>
              <td class="p-3 text-emerald-700 font-bold">免受公网审查，无阻断风险</td>
              <td class="p-3 text-emerald-700 font-bold">免受公网审查，无阻断风险</td>
              <td class="p-3 text-amber-700">可能面临公网端口封锁或协议阻断</td>
            </tr>
            <tr class="hover:bg-brand-light/50">
              <td class="p-3 font-bold text-brand-dark">晚高峰 QoS 抖动表现</td>
