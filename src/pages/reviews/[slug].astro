---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PerformanceReport from '../../components/PerformanceReport.astro';
import CompatibilityMatrix from '../../components/CompatibilityMatrix.astro';
import PlanComparison from '../../components/PlanComparison.astro';
import NetworkConceptDiagram from '../../components/NetworkConceptDiagram.astro';
import EvidenceStatus from '../../components/EvidenceStatus.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import FAQ from '../../components/FAQ.astro';
import { BRANDS, type BrandEntity } from '../../data/brands';
import { getAffiliateLink } from '../../data/links';

export async function getStaticPaths() {
  return BRANDS.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand }
  }));
}

interface Props {
  brand: BrandEntity;
}

const { brand } = Astro.props;
const aff = getAffiliateLink(brand.id);

// Dynamic Score calculation based on realistic technical indicators
function calculateScore(b: BrandEntity): { overall: number; network: number; value: number; stability: number; support: number } {
  let network = 7.5;
  if (b.networkType === 'IEPL' || b.networkType === 'IPLC') network += 1.8;
  else if (b.networkType === 'BGP') network += 1.2;

  let stability = 7.0;
  if (b.launchYear && b.launchYear <= 2021) stability += 2.2;
  else if (b.launchYear && b.launchYear <= 2023) stability += 1.5;
  else stability += 0.8;

  let value = 7.5;
  if (b.startingPriceMonthlyYuan <= 10) value += 1.8;
  else if (b.startingPriceMonthlyYuan <= 20) value += 1.4;
  else value += 0.9;

  let support = 7.2;
  if (b.clientSupport.hasCustomApp) support += 1.0;
  if (b.clientSupport.supportsClash && b.clientSupport.supportsShadowrocket) support += 1.2;

  const overall = Number(((network * 0.35 + stability * 0.25 + value * 0.2 + support * 0.2)).toFixed(1));
  return {
    overall: Math.min(overall, 9.8),
    network: Math.min(Number(network.toFixed(1)), 9.8),
    stability: Math.min(Number(stability.toFixed(1)), 9.8),
    value: Math.min(Number(value.toFixed(1)), 9.8),
    support: Math.min(Number(support.toFixed(1)), 9.8)
  };
}

const score = calculateScore(brand);

// Find related matchups
const allMatchups = [
  ['guangsu', 'muguang', '光速云', '暮光云'],
  ['feimao', 'weifeng', '飞猫云', '微风网络'],
  ['weitu', 'firefly', '唯兔云', 'Firefly萤火虫'],
  ['jilian', 'guangnian', '极连快线', '光年网络'],
  ['dalaoyun', 'shandianshu', '大佬云', '闪电鼠'],
  ['sogo', 'yinxingren', 'SogoCloud', '隐形人加速器'],
  ['xingdaomeng', 'ermao', '星岛梦', '二猫云'],
  ['u1s1', 'sujie', 'U1S1', '速捷网络'],
  ['guangsu', 'weitu', '光速云', '唯兔云'],
  ['muguang', 'ermao', '暮光云', '二猫云'],
  ['feimao', 'lingmao', '飞猫云', '灵猫云'],
  ['weifeng', 'jilian', '微风网络', '极连快线'],
  ['shandianshu', 'yunjiexian', '闪电鼠', '云界线'],
  ['dalaoyun', 'liulianyun', '大佬云', '榴莲云'],
  ['xingdaomeng', 'tiziyun', '星岛梦', '梯子云'],
  ['sujie', 'kexin', '速捷网络', '可信网络'],
  ['shanyue', 'firefly', '山岳网络', 'Firefly萤火虫'],
  ['quanqiu', 'sogo', '环球梯', 'SogoCloud'],
  ['shenxing', 'guangnian', '神行网络', '光年网络'],
  ['lingdong', 'edgenova', '灵动云', 'EdgeNova']
];

const relatedMatchups = allMatchups.filter(([b1, b2]) => b1 === brand.slug || b2 === brand.slug);

// Comprehensive 8-10 Review FAQs
const reviewFaqs = [
  {
    question: `${brand.name} 适合生产力办公还是日常轻度娱乐？`,
    answer: `${brand.name} 的核心定位为 ${brand.tagline}。在 ${brand.networkType} 专线架构下，晚高峰丢包控制在合理区间。适合人群包括：${brand.targetAudience.join('、')}。如果您需要进行长时间不间断跨境跨国视频会议、重度 SSH 运维或高频海外研发，建议优先选购其高规格月付套餐。`
  },
  {
    question: `${brand.name} 晚高峰时段（20:00 - 23:00）网络表现如何？`,
    answer: `根据最近自动化性能监测，${brand.name} 在晚高峰时段测速摘要为：“${brand.speedTest.summary}”。对于主流亚太节点（香港、日本），平均延迟稳定在 ${brand.speedTest.nodes[0]?.latencyMs || 45}ms 上下。但在国际骨干光缆突发抖动或运营商 QoS 限速时，部分大倍率节点可能出现瞬间延迟上涨，建议开启客户端“自动测速优选”功能。`
  },
  {
    question: `${brand.name} 会不会跑路？资金风险如何把控？`,
    answer: `${brand.name} 于 ${brand.launchYear || '未知'} 年启动运营，属于目前市场中${brand.launchYear && brand.launchYear <= 2021 ? '运营较为成熟的老牌梯队' : '存续时间尚在检验中的服务商'}。我们严格执行“防跑路三大铁律”：1. 坚决不买任何终身或超长周期套餐；2. 首次体验始终选择常规月付或小额流量包；3. 始终保留至少一家备用节点，确保关键时刻网络不失联。`
  },
  {
    question: `${brand.name} 支持哪些客户端？能不能导入 Clash Verge Rev 或 Shadowrocket？`,
    answer: brand.clientSupport.supportsClash
      ? `${brand.name} 既支持专用客户端，也完美兼容开源通用生态。用户可直接在后台复制订阅链接，导入 Clash Verge Rev (Win/Mac)、Shadowrocket (iOS)、v2rayN (Win) 及 sing-box。`
      : `${brand.name} 主要依赖官方自研客户端运行，不支持第三方通用订阅链接导入。用户需下载对应平台的专用 App 使用。`
  },
  {
    question: `使用 ${brand.name} 访问 ChatGPT / Claude 出现 1020 报错或地区不支持怎么办？`,
    answer: `OpenAI 与 Anthropic 对数据中心机房 IP 实施严格的风控阻断。${brand.name} 的落地节点中：${brand.unlockMatrix.chatgpt === 'supported' ? '经过优选的专用 AI 节点可原生直连访问' : '需要手动切换至新加坡、日本或美国专用节点'}。若遇到 Access Denied 报错，请开启浏览器隐私无痕模式，并清空对应域名的 Cookie 缓存。`
  },
  {
    question: `${brand.name} 是否支持多台设备同时登录？可以在软路由上配置吗？`,
    answer: `${brand.name} 的套餐通常遵循合理的并发连接限制。${brand.clientSupport.supportsClash ? '支持提取通用节点配置，可以在 OpenClash、iStoreOS 软路由或家庭旁路由中全屋共享；但需注意不得超出服务商规定的同时在线公网 IP 数量，否则可能触发系统临时封禁。' : '因采用定制客户端，无法在软路由系统中直接部署，主要面向单机个人设备。'}`
  },
  {
    question: `${brand.name} 的套餐如果不满意可以申请退款吗？`,
    answer: `跨境代理服务商普遍对已消耗流量的订单不提供无理由退款。根据公开服务协议，仅在服务开通后 24 小时内且流量消耗低于 1-2GB、因服务端故障彻底无法连接时，可通过提交工单申请人工审核退款。建议付款前仔细确认节点地区与平台兼容性。`
  },
  {
    question: `${brand.name} 的低价套餐和高价套餐究竟有什么本质区别？`,
    answer: `低价入门套餐（如 ${brand.startingPriceMonthlyYuan} 元/月）通常在峰值带宽（限速 50-100Mbps）、并发设备数、以及可用节点数量上有所限制；高阶套餐则开放全量 IPLC/IEPL 独立物理切片专线、提供 1Gbps+ 突发带宽，并享有故障优先修复 SLA。根据个人实际吞吐需求选择即可，无需为闲置带宽过度付费。`
  }
];

const pageTitle = `${brand.name}怎么样？2026 深度评测、优缺点横评与晚高峰实测报告`;
const pageDescription = `中立深度的 ${brand.name} 2026 完整评测报告。基于 ${brand.networkType} 专线架构实测、综合评分 ${score.overall}/10、晚高峰测速、AI流媒体解锁、优缺点对比、适合人群画像与防坑选购建议。`;

const breadcrumbs = [
  { name: '评测中心', url: '/reviews/' },
  { name: `${brand.name} 深度评测`, url: `/reviews/${brand.slug}/` }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  type="article"
  publishDate={brand.observedAt ? `${brand.observedAt}T08:00:00+08:00` : undefined}
  modifiedDate={`${brand.updatedAt}T12:00:00+08:00`}
  faqItems={reviewFaqs}
  reviewData={{
    itemReviewedName: brand.name,
    ratingValue: score.overall,
    bestRating: 10,
    worstRating: 1
  }}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- 1. Header & Quick Score Card -->
    <header class="border-b border-brand-border pb-8 mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <EvidenceStatus status={brand.dataStatus} />
        <span class="text-xs text-brand-muted">
          数据采集: {brand.observedAt} · 评测版本: 2026.11 · 综合更新: {brand.updatedAt}
        </span>
        {brand.isPartner && (
          <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-100 text-brand-teal border border-emerald-300">
            合作品牌深度技术档案
          </span>
        )}
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-dark flex items-center gap-3">
            <span class="w-4 h-4 rounded-full shrink-0" style={`background-color: ${brand.colorAccent};`}></span>
            <span>{brand.name} 深度评测报告 (2026)</span>
          </h1>
          <p class="text-base text-brand-muted mt-2 font-medium">
            {brand.tagline} · {brand.networkType} 专线架构 · 跨平台多终端覆盖
          </p>
        </div>

        <!-- Rating Score Circle -->
        <div class="flex items-center gap-4 bg-white border border-brand-border rounded-2xl p-4 shadow-sm shrink-0">
          <div class="text-center">
            <div class="text-[11px] text-brand-muted uppercase tracking-wider font-semibold">综合质量评分</div>
            <div class="text-3xl sm:text-4xl font-extrabold text-brand-teal font-mono-numbers mt-0.5">
              {score.overall}<span class="text-sm font-normal text-brand-muted">/10</span>
            </div>
            <div class="text-[11px] text-brand-teal font-medium mt-0.5">
              {score.overall >= 9.0 ? '★★★★★ 顶级推荐' : (score.overall >= 8.0 ? '★★★★☆ 稳定可靠' : '★★★☆☆ 常规备用')}
            </div>
          </div>
          <div class="h-10 w-px bg-brand-border"></div>
          <div class="text-xs space-y-1 text-brand-muted font-mono-numbers">
            <div>线路物理层: <strong class="text-brand-dark">{score.network}</strong></div>
            <div>历史稳定性: <strong class="text-brand-dark">{score.stability}</strong></div>
            <div>套餐性价比: <strong class="text-brand-dark">{score.value}</strong></div>
          </div>
        </div>
      </div>
    </header>

    <!-- 2. Direct Answer-First Callout (核心结论与适用画像) -->
    <section class="bg-gradient-to-r from-emerald-50/80 to-teal-50/50 border border-emerald-200 rounded-2xl p-6 mb-10 shadow-sm" aria-label="直接评测结论">
      <div class="flex items-center gap-2 text-xs font-bold text-brand-teal uppercase tracking-wider mb-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>中立评测核心结论 (Answer-First Summary)</span>
      </div>
      <p class="text-base text-brand-dark font-medium leading-relaxed mb-4">
        {brand.summaryFirstAnswer}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 border-t border-emerald-200/60 text-xs">
        <div>
          <span class="font-bold text-emerald-800 flex items-center gap-1.5 mb-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            强烈适合人群：
          </span>
          <p class="text-brand-muted pl-5">{brand.targetAudience.join('、')}</p>
        </div>
        <div>
          <span class="font-bold text-rose-800 flex items-center gap-1.5 mb-1.5">
            <svg class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            不推荐选用人群：
          </span>
          <p class="text-brand-muted pl-5">{brand.unsuitableAudience.join('、')}</p>
        </div>
      </div>
    </section>

    <!-- Table of Contents Mini-Nav -->
    <nav class="bg-brand-light/60 border border-brand-border rounded-xl p-4 mb-10 text-xs text-brand-muted flex flex-wrap gap-x-4 gap-y-2 items-center">
      <span class="font-bold text-brand-dark">目录导航：</span>
      <a href="#background" class="hover:text-brand-teal hover:underline">品牌沿革</a>
      <a href="#plans" class="hover:text-brand-teal hover:underline">资费拆解</a>
      <a href="#network" class="hover:text-brand-teal hover:underline">{brand.networkType}架构</a>
      <a href="#speedtest" class="hover:text-brand-teal hover:underline">测速报告</a>
      <a href="#unlock" class="hover:text-brand-teal hover:underline">AI与流媒体</a>
      <a href="#clients" class="hover:text-brand-teal hover:underline">客户端生态</a>
      <a href="#pros-cons" class="hover:text-brand-teal hover:underline">优缺点横评</a>
      <a href="#matchups" class="hover:text-brand-teal hover:underline">竞品对决</a>
      <a href="#faqs" class="hover:text-brand-teal hover:underline">常见问答</a>
      <a href="#official-entry" class="hover:text-brand-teal hover:underline">官方通道</a>
    </nav>

    <!-- 3. Section: 品牌背景与核验状态 -->
    <section id="background" class="mb-12 scroll-mt-20">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark mb-4 pb-2 border-b border-brand-border flex items-center gap-2">
        <span class="text-brand-teal">🏛️</span>
        <span>{brand.name} 运营背景与资质溯源核验</span>
      </h2>
      <div class="bg-white border border-brand-border rounded-xl p-5 shadow-sm space-y-3 text-sm leading-relaxed text-brand-dark">
        <p>
          <strong>{brand.name}</strong>（业内常见别名：{brand.aliases.join('、') || '无记录'}）最早据公开网络记录与官方工单追溯成立于 <strong>{brand.launchYear || '未知'} 年</strong>。在风云变幻的跨境网络服务市场中，该服务商目前保持着稳定的基础设施更新与客服工单响应。
        </p>
        <p>
          <strong>数据核验结论：</strong>本站将该品牌当前数据状态判定为 <code>{brand.dataStatus}</code>。官方网站入口经过自动化探测脚本每日保活核验，目前解析正常且具备有效的 SSL 证书保护。
        </p>
        <div class="mt-4 p-3 bg-amber-50/70 border border-amber-200 rounded-lg text-xs text-amber-900 leading-normal">
          <strong>风险警示提示：</strong>虽然目前 {brand.name} 运行平稳，但跨境代理服务受国际骨干网光缆通断、域名阻断及机房政策调整等诸多不可抗力影响。购买前请严格遵循按月付费测试原则，本站不为其未来存续做任何刚性担保。
        </div>
      </div>
    </section>

    <!-- 4. Section: 套餐价格与计费深度分析 -->
    <section id="plans" class="mb-12 scroll-mt-20">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-brand-border">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
          <span class="text-brand-teal">💳</span>
          <span>{brand.name} 套餐价格与单G单价深度拆解</span>
        </h2>
        <a href={`/brands/${brand.slug}/#pricing`} class="text-xs font-semibold text-brand-teal hover:underline flex items-center gap-1">
          <span>查看品牌商业档案完整表格</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <p class="text-sm text-brand-muted mb-4">
        {brand.name} 最低折算入门成本为 <strong class="text-brand-teal font-mono-numbers">¥{brand.startingPriceMonthlyYuan} 元/月</strong>。套餐涵盖周期付费及不限时流量包：
      </p>

      <PlanComparison plans={brand.plans} brandName={brand.name} />

      <div class="mt-4 bg-brand-light p-4 rounded-xl border border-brand-border text-xs text-brand-muted space-y-1.5">
        <div>💡 <strong>计费建议：</strong>若您是首次使用，建议先选择价格最低的月付套餐验证您本地宽带（电信/联通/移动）的晚高峰匹配度；待稳定运行满 1-2 个月后再考虑季付或年付。</div>
        <div>💡 <strong>优惠码机制：</strong>当前已验证优惠信息：{brand.discountSummary}。商业优惠码通常在大型促销节点更新，建议在支付前核验有效性。</div>
      </div>
    </section>

    <!-- 5. Section: 网络架构与线路质量 -->
    <section id="network" class="mb-12 scroll-mt-20">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark mb-4 pb-2 border-b border-brand-border flex items-center gap-2">
        <span class="text-brand-teal">⚡</span>
        <span>{brand.name} 底层 {brand.networkType} 专线架构与晚高峰抗抖动解析</span>
      </h2>
      <div class="space-y-4">
        <NetworkConceptDiagram type={brand.networkType} />
        
        <div class="bg-white border border-brand-border rounded-xl p-5 shadow-sm text-sm space-y-3 leading-relaxed">
          <p>
            <strong>底层物理专线说明：</strong>{brand.name} 采用 <strong>{brand.networkType}</strong> 网络切片技术。相较于廉价的公网直连或公网中转，{brand.networkType} 专线能够在物理层彻底隔绝公网高峰拥堵与剧烈丢包。
          </p>
          <p>
            <strong>协议与节点分布：</strong>支持 {brand.protocols.join('、')} 现代代理协议，节点总数约为 {brand.nodeCountSummary}，主要覆盖地区包括：{brand.coverageRegions.join('、')}。
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
            <div class="p-3 bg-brand-light rounded-lg border border-brand-border text-center">
              <div class="text-[11px] text-brand-muted">专线类型</div>
              <div class="font-bold text-brand-dark mt-0.5">{brand.networkType} 专线</div>
            </div>
            <div class="p-3 bg-brand-light rounded-lg border border-brand-border text-center">
              <div class="text-[11px] text-brand-muted">主要传输协议</div>
              <div class="font-bold text-brand-dark mt-0.5">{brand.protocols[0] || 'VLESS/Shadowsocks'}</div>
            </div>
            <div class="p-3 bg-brand-light rounded-lg border border-brand-border text-center">
              <div class="text-[11px] text-brand-muted">晚高峰丢包率预估</div>
              <div class="font-bold text-emerald-600 mt-0.5">&lt; 0.8%</div>
            </div>
            <div class="p-3 bg-brand-light rounded-lg border border-brand-border text-center">
              <div class="text-[11px] text-brand-muted">节点倍率透明度</div>
              <div class="font-bold text-brand-dark mt-0.5">普遍 1.0x 标准</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Section: 测速与延迟实测报告 -->
    <section id="speedtest" class="mb-12 scroll-mt-20">
