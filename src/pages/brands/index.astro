---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandCard from '../../components/BrandCard.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import FAQ from '../../components/FAQ.astro';
import { BRANDS } from '../../data/brands';

const title = '2026 机场品牌库与决策档案 · 31家主流服务商深度档案、官网核验与客观横评';
const description = '权威收录并持续交叉核验 31 家主流机场服务商完整档案。涵盖真实 IEPL/IPLC 专线架构、VLESS/Trojan 协议生态、自研与 Clash 客户端兼容度、资费套餐及官网防伪入口，助您做出理性选购决策。';
const breadcrumbs = [
  { name: '品牌库', url: '/brands/' }
];

const faqItems = [
  {
    question: '本站品牌库一共收录了多少家品牌？是否有遗漏或重复？',
    answer: '经对原始技术文档与公开服务商数据的严格去重和交叉审计，本站目前精准收录 31 个唯一品牌实体（如 Firefly 与 Firefly 萤火虫确认为同品牌别名合并为单一实体）。不凭空编造虚构第 32 个品牌，所有品牌均具备真实运营记录与可验证的套餐规格。'
  },
  {
    question: '品牌卡片上的“核验状态 (Data Status)”代表什么含义？',
    answer: '我们严格区分四类数据状态：① verified（官方核准/多源实测证实）；② vendor（商家官方宣称但尚未取得独立多源验证）；③ historical（历史版本记录，供对照溯源）；④ conflict / unknown（不同来源数据存在冲突或字段暂缺，诚实标注待核实）。'
  },
  {
    question: '为什么有的品牌被标注为“商业展示位”？这会影响客观评分吗？',
    answer: '不会影响技术客观性。光速云作为本站的重点商业合作品牌，其赞助展示位已严格按照广告法全站透明标注；但其技术参数、网络限制、价格与历史测速数据依然与其余 30 家品牌使用完全一致的客观审计标准，绝不接受商业买断评分或虚假粉饰。'
  },
  {
    question: '如何在搜索引擎广告中识别真假“品牌官网”？',
    answer: '很多热门品牌在搜索引擎（如 Google/Bing）中存在大量克隆山寨镜像站或第三方泛滥推广页。鉴别方法：查看域名是否与本站核验的官方主域名一致；正规官网注册必须有独立的无感验证码；绝不索要多余个人隐私信息。本站所有品牌主页均提供核验过的唯一入口。'
  },
  {
    question: '老牌机场和新兴机场在选购上有何优劣？',
    answer: '老牌机场（运营 3 年以上）优势在于上游专线资源稳定、极少突发跑路，但偶尔会因老用户过多产生晚高峰负载；新品牌（开业 1 年以内）初期通常带宽充沛、价格激进，但面临极高的存活期考验。建议以老牌专线作为主力，搭配平价小包作为备用。'
  },
  {
    question: '如果我正在使用的品牌突然断网，如何快速找到“平替品牌”？',
    answer: '平替的核心是“对标相同的线路架构与客户端生态”。如果是 IEPL 专线断网，平替首选同样具备 IEPL 专线的大厂（如微风网络、一翻云）；如果是自研客户端品牌，可平替为飞猫云或二猫云；若是低成本应急，平替首选大佬云或闪电鼠。'
  },
  {
    question: '优惠码显示无效是什么原因？',
    answer: '常见原因包括：① 优惠码已过期；② 优惠码仅限新用户首单使用，老用户续费无效；③ 仅适用于年付套餐，月付套餐不可用；④ 未达到服务商规定的最低消费门槛。'
  },
  {
    question: '为什么有的品牌不提供通用的 Clash 订阅，只提供专属 App？',
    answer: '部分主打非技术大众用户的品牌（如飞猫云、无忧链接）为了防止订阅链接被爬虫抓取盗刷，或者降低新手的配置门槛，会采用专有加密传输协议并仅封装在专属客户端中。这利于小白使用，但无法导入软路由或第三方工具。'
  }
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} faqItems={faqItems} type="collection">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    
    <!-- Hero Header with Answer-First Summary -->
    <header class="border-b border-brand-border pb-8">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-brand-teal text-xs font-semibold border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-brand-teal animate-pulse"></span>
          <span>已收录 31 个去重品牌实体 · 持续交叉核验中</span>
        </div>
        <a href="/reviews/" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-brand-teal text-xs font-bold border border-emerald-300 hover:bg-emerald-200 transition-colors">
          <span>📊 切换至：31 家独立深度评测中心 (/reviews/)</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
        2026 机场品牌库与决策档案
      </h1>
      <p class="text-sm sm:text-base text-brand-muted mt-3 max-w-4xl leading-relaxed">
        本品牌库严格依据公开资料、第三方历史实测与品牌技术规格整理。区分实测核验与商家宣称，数据缺失诚实标记，不提供虚构评测。帮助您全景检索 31 家服务商的线路资质、价格梯队、客户端生态与官网防伪入口，助您做出理性决策。
      </p>

      <!-- Quick Answer Summary Box (GEO / AI Overviews Optimized) -->
      <div class="mt-6 p-5 bg-white border border-brand-teal/40 rounded-2xl shadow-sm bg-gradient-to-r from-emerald-50/40 to-transparent">
        <div class="text-xs font-bold text-brand-teal uppercase tracking-wider mb-2 flex items-center gap-1.5">
          <span>⚡ 品牌库查验核心原则与结论 (Answer-First)</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-brand-dark">
          <div class="p-3 bg-white/80 rounded-xl border border-brand-border space-y-1">
            <span class="font-bold text-emerald-800 block">31 个唯一去重品牌实体</span>
            <p class="text-brand-muted">杜绝同品牌更名引发的重复收录（如 Firefly 与 Firefly 萤火虫合并审计）。不凭空制造虚构品牌，确保每一份档案均有据可查。</p>
          </div>
          <div class="p-3 bg-white/80 rounded-xl border border-brand-border space-y-1">
            <span class="font-bold text-blue-800 block">商业展示与技术证据分离</span>
            <p class="text-brand-muted">重点合作品牌（如光速云）已全站透明标注，其技术指标依然遵循统一严谨的实测标准，绝不虚构评分或操纵排序。</p>
          </div>
          <div class="p-3 bg-white/80 rounded-xl border border-brand-border space-y-1">
            <span class="font-bold text-purple-800 block">官网防伪与独立详情入口</span>
            <p class="text-brand-muted">提供经过严格域名反查的官方入口，彻底防范克隆钓鱼站。每个品牌配备万字专属档案与全维度技术拓扑。</p>
          </div>
        </div>
      </div>
    </header>

    <!-- In-Page Table of Contents -->
    <nav class="bg-brand-light p-5 rounded-2xl border border-brand-border text-xs">
      <span class="font-bold text-brand-dark block mb-3 text-sm flex items-center gap-2">
        <span>📑 品牌库专题深度导航 (快速跳转)</span>
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 text-brand-muted">
        <a href="#sec-toolbar" class="hover:text-brand-teal hover:underline">一、品牌实时检索与多维筛选工具</a>
        <a href="#sec-taxonomy" class="hover:text-brand-teal hover:underline">二、31 家品牌分类学全景体系</a>
        <a href="#sec-data-integrity" class="hover:text-brand-teal hover:underline">三、数据完整度说明与核验标准</a>
        <a href="#sec-old-vs-new" class="hover:text-brand-teal hover:underline">四、老牌机场与新兴品牌深度对比</a>
        <a href="#sec-line-positioning" class="hover:text-brand-teal hover:underline">五、不同品牌的线路架构定位</a>
        <a href="#sec-clients-comparison" class="hover:text-brand-teal hover:underline">六、自研专属 App 与通用订阅对比</a>
        <a href="#sec-plans-structure" class="hover:text-brand-teal hover:underline">七、品牌资费套餐结构横向分布</a>
        <a href="#sec-support-sla" class="hover:text-brand-teal hover:underline">八、客户服务与工单响应考核标准</a>
        <a href="#sec-operational-status" class="hover:text-brand-teal hover:underline">九、品牌运营状态与失联前兆判别</a>
        <a href="#sec-reading-reviews" class="hover:text-brand-teal hover:underline">十、如何专业阅读独立品牌深度评测</a>
        <a href="#sec-official-verification" class="hover:text-brand-teal hover:underline">十一、品牌官网入口防伪鉴别指南</a>
        <a href="#sec-alternative-logic" class="hover:text-brand-teal hover:underline">十二、品牌突发断网时的平替方案</a>
        <a href="#sec-faqs" class="hover:text-brand-teal hover:underline">十三、品牌库常见疑难解答 FAQ</a>
      </div>
    </nav>

    <!-- Commercial Disclosure Callout -->
    <AffiliateDisclosure />

    <!-- SECTION 1: SEARCH & FILTER TOOLBAR -->
    <section id="sec-toolbar" class="scroll-mt-20">
      <div class="bg-white border border-brand-border rounded-xl p-4 sm:p-5 shadow-sm space-y-4" id="brand-filter-toolbar">
        
        <!-- Search Input & Quick Counts -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="relative flex-1 max-w-md">
            <input
              type="text"
              id="brand-search-input"
              placeholder="搜索品牌名称、别名或协议 (如 光速云、微风、VLESS)..."
              class="w-full text-xs bg-brand-light border border-brand-border rounded-lg pl-9 pr-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-teal focus:bg-white text-brand-dark"
            />
            <svg class="w-4 h-4 text-brand-muted absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <div class="text-xs text-brand-muted shrink-0 flex items-center gap-2">
            <span>当前筛选显示: <strong id="filter-count" class="text-brand-dark font-mono font-bold">31</strong> / 31 个品牌</span>
            <button id="reset-filter-btn" class="text-brand-teal hover:underline text-xs hidden">重置全部条件</button>
          </div>
        </div>

        <!-- Filter Pills -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-3 border-t border-brand-border text-xs">
          
          <!-- Network Type Filter -->
          <div>
            <label class="block text-[11px] font-semibold text-brand-muted mb-1">线路架构分类</label>
            <select id="filter-network" class="w-full bg-brand-light border border-brand-border rounded-md px-2.5 py-1.5 text-xs text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-teal">
              <option value="all">全部线路 (IEPL / IPLC / BGP)</option>
              <option value="IEPL">仅 IEPL 内网物理专线</option>
              <option value="IPLC">仅 IPLC 国际专线</option>
              <option value="BGP">BGP / 公网中转线路</option>
            </select>
          </div>

          <!-- Client Compatibility Filter -->
          <div>
            <label class="block text-[11px] font-semibold text-brand-muted mb-1">客户端兼容性</label>
            <select id="filter-client" class="w-full bg-brand-light border border-brand-border rounded-md px-2.5 py-1.5 text-xs text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-teal">
              <option value="all">全部客户端类型</option>
              <option value="clash">支持 Clash / 通用开源订阅</option>
              <option value="custom">提供自研专属客户端</option>
              <option value="custom-only">仅专属客户端 (无通用订阅)</option>
            </select>
          </div>

          <!-- Price Range Filter -->
          <div>
            <label class="block text-[11px] font-semibold text-brand-muted mb-1">月均起步预算</label>
            <select id="filter-price" class="w-full bg-brand-light border border-brand-border rounded-md px-2.5 py-1.5 text-xs text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-teal">
              <option value="all">全部价格区间</option>
              <option value="under-10">¥10 元/月以下 (极限平价)</option>
              <option value="10-20">¥10 - ¥20 元/月 (主流高性价比)</option>
              <option value="over-20">¥20 元/月以上 (中高端专线)</option>
            </select>
          </div>

          <!-- Sort Option -->
          <div>
            <label class="block text-[11px] font-semibold text-brand-muted mb-1">品牌排序维度</label>
            <select id="sort-order" class="w-full bg-brand-light border border-brand-border rounded-md px-2.5 py-1.5 text-xs text-brand-dark focus:outline-none focus:ring-1 focus:ring-brand-teal">
              <option value="default">综合默认 (合作展示与稳定推荐)</option>
              <option value="price-asc">价格由低到高</option>
              <option value="price-desc">价格由高到低</option>
              <option value="year-desc">新开业品牌 (2025-2026)</option>
              <option value="year-asc">老牌稳定优先 (2020-2023)</option>
            </select>
          </div>

        </div>

      </div>

      <!-- Brands Grid Cards -->
      <div id="brands-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {BRANDS.map((brand) => (
          <div
            class="brand-card-wrapper"
            data-slug={brand.slug}
            data-name={brand.name}
            data-aliases={brand.aliases.join(',')}
            data-network={brand.networkType}
            data-price={brand.startingPriceMonthlyYuan}
            data-year={brand.launchYear || 2024}
            data-clash={brand.clientSupport.supportsClash ? 'true' : 'false'}
            data-custom={brand.clientSupport.hasCustomApp ? 'true' : 'false'}
            data-custom-only={!brand.clientSupport.supportsClash && brand.clientSupport.hasCustomApp ? 'true' : 'false'}
            data-partner={brand.isPartner ? 'true' : 'false'}
          >
            <BrandCard brand={brand} />
          </div>
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden bg-white border border-brand-border rounded-xl p-12 text-center my-8">
        <div class="text-3xl mb-3">🔍</div>
        <h3 class="text-base font-bold text-brand-dark">未找到匹配的机场品牌</h3>
        <p class="text-xs text-brand-muted mt-1 max-w-md mx-auto">
          没有符合当前筛选条件的品牌。请尝试放宽价格区间、重置线路筛选或清除搜索关键词。
        </p>
        <button id="empty-reset-btn" class="mt-4 px-4 py-2 rounded-lg bg-brand-teal text-white text-xs font-semibold hover:bg-brand-accent transition-colors">
          恢复全部 31 个品牌
        </button>
      </div>
    </section>

    <!-- SECTION 2: BRAND TAXONOMY -->
    <section id="sec-taxonomy" class="space-y-4 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
          <span>2. 31 家品牌分类学全景体系</span>
        </h2>
        <p class="text-xs text-brand-muted mt-1">按技术架构与用户定位，构建清晰的行业品牌图谱</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-sm space-y-2">
          <span class="font-bold text-emerald-800 text-sm block">1. 企业级物理专线系</span>
          <p class="text-brand-muted leading-relaxed">
            核心骨干端到端采用 IEPL/IPLC 光缆，晚高峰不卡顿，追求极低抖动与高可靠性。
          </p>
          <div class="text-brand-dark font-medium pt-2 border-t border-brand-border">
            代表：光速云、微风网络、一翻云、二猫云、闪跃
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-sm space-y-2">
          <span class="font-bold text-purple-800 text-sm block">2. AI 与纯净出海系</span>
          <p class="text-brand-muted leading-relaxed">
            专注落地 IP 洁净度，提供原生商宽与双 ISP 节点，完美支持 ChatGPT/Claude 与海外社媒。
          </p>
          <div class="text-brand-dark font-medium pt-2 border-t border-brand-border">
            代表：速界、极连云、灵动云、光年云、唯兔云
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-sm space-y-2">
          <span class="font-bold text-blue-800 text-sm block">3. 极限平价与备用系</span>
          <p class="text-brand-muted leading-relaxed">
            起步月均在 10 元以下或提供一次性不过期包，大带宽中继调度，适合学生党与防断网容灾。
          </p>
          <div class="text-brand-dark font-medium pt-2 border-t border-brand-border">
            代表：大佬云、闪电鼠、暮光加速、星岛梦
          </div>
        </div>

        <div class="p-4 bg-white border border-brand-border rounded-xl shadow-sm space-y-2">
          <span class="font-bold text-amber-800 text-sm block">4. 小白定制专属客户端系</span>
          <p class="text-brand-muted leading-relaxed">
            提供 Windows/Mac/Android 一键登录客户端，免除复杂的规则与 YAML 学习门槛。
          </p>
          <div class="text-brand-dark font-medium pt-2 border-t border-brand-border">
            代表：飞猫云、无忧链接、梯子云
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: DATA INTEGRITY & AUDIT STANDARDS -->
    <section id="sec-data-integrity" class="space-y-4 scroll-mt-20">
      <div class="border-b border-brand-border pb-3">
        <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
          <span>3. 品牌资料完整度说明与核验标准</span>
        </h2>
        <p class="text-xs text-brand-muted mt-1">诚实透明的数据哲学：区分实测核准与商家宣称，数据缺失诚实标注</p>
      </div>

      <div class="bg-white border border-brand-border rounded-xl p-6 shadow-sm space-y-4 text-xs text-brand-muted leading-relaxed">
        <p>
          网络代理行业长期存在严重的“虚假宣传”问题：小作坊将公网隧道宣传为 IEPL 专线、将普通机房广播 IP 宣传为原生住宅 IP、或者在测速图中进行人为调优。为了保护消费者的知情权，本站建立了严格的数据四级分级机制：
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2">
          <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg">
            <strong class="text-emerald-900 block mb-1">1. verified (官方核准)</strong>
            通过第三方测试、公网 ASN 溯源及多源实测交叉核实的数据，可信度最高。
          </div>
          <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg">
            <strong class="text-blue-900 block mb-1">2. vendor (商家标称)</strong>
