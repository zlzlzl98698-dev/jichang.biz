        <a href="/compare/" class="p-3 bg-white border border-brand-border hover:border-brand-teal rounded-xl shadow-sm text-center font-bold text-brand-dark hover:text-brand-teal transition">
          🔍 查看全部 20 组对决 →
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  function initBrandFilter() {
    const searchInput = document.getElementById('brand-search-input') as HTMLInputElement;
    const filterNetwork = document.getElementById('filter-network') as HTMLSelectElement;
    const filterClient = document.getElementById('filter-client') as HTMLSelectElement;
    const filterPrice = document.getElementById('filter-price') as HTMLSelectElement;
    const sortOrder = document.getElementById('sort-order') as HTMLSelectElement;
    const countEl = document.getElementById('filter-count');
    const resetBtn = document.getElementById('reset-filter-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const emptyState = document.getElementById('empty-state');
    const grid = document.getElementById('brands-grid');
    const cards = Array.from(document.querySelectorAll('.brand-card-wrapper')) as HTMLElement[];

    if (!searchInput || !cards.length) return;

    function applyFilterAndSort() {
      const query = searchInput.value.trim().toLowerCase();
      const network = filterNetwork.value;
      const client = filterClient.value;
      const price = filterPrice.value;
      const sort = sortOrder.value;

      let visibleCards = cards.filter(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const aliases = (card.dataset.aliases || '').toLowerCase();
        const cNetwork = card.dataset.network || '';
        const cPrice = parseFloat(card.dataset.price || '0');
        const cClash = card.dataset.clash === 'true';
        const cCustom = card.dataset.custom === 'true';
        const cCustomOnly = card.dataset.customOnly === 'true';

        // 1. Text Search
        if (query && !name.includes(query) && !aliases.includes(query)) {
          return false;
        }

        // 2. Network Type
        if (network !== 'all' && !cNetwork.includes(network)) {
          return false;
        }

        // 3. Client
        if (client === 'clash' && !cClash) return false;
        if (client === 'custom' && !cCustom) return false;
        if (client === 'custom-only' && !cCustomOnly) return false;

        // 4. Price
        if (price === 'under-10' && cPrice >= 10) return false;
        if (price === '10-20' && (cPrice < 10 || cPrice > 20)) return false;
        if (price === 'over-20' && cPrice <= 20) return false;

        return true;
      });

      // Sorting
      if (sort === 'price-asc') {
        visibleCards.sort((a, b) => parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0'));
      } else if (sort === 'price-desc') {
        visibleCards.sort((a, b) => parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0'));
      } else if (sort === 'year-desc') {
        visibleCards.sort((a, b) => parseInt(b.dataset.year || '0') - parseInt(a.dataset.year || '0'));
      } else if (sort === 'year-asc') {
        visibleCards.sort((a, b) => parseInt(a.dataset.year || '0') - parseInt(b.dataset.year || '0'));
      } else {
        // Default: Partner first, then stable brands
        visibleCards.sort((a, b) => {
          const aPartner = a.dataset.partner === 'true' ? 1 : 0;
          const bPartner = b.dataset.partner === 'true' ? 1 : 0;
          return bPartner - aPartner;
        });
      }

      // Hide all first
      cards.forEach(c => c.style.display = 'none');

      // Re-append in sorted order and show
      if (grid) {
        visibleCards.forEach(c => {
          c.style.display = '';
          grid.appendChild(c);
        });
      }

      // Update Count & Empty state
      if (countEl) countEl.textContent = visibleCards.length.toString();
      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCards.length > 0);
      }

      // Show/Hide Reset Button
      const hasFilter = query || network !== 'all' || client !== 'all' || price !== 'all' || sort !== 'default';
      if (resetBtn) resetBtn.classList.toggle('hidden', !hasFilter);
    }

    function resetAll() {
      searchInput.value = '';
      filterNetwork.value = 'all';
      filterClient.value = 'all';
      filterPrice.value = 'all';
      sortOrder.value = 'default';
      applyFilterAndSort();
    }

    searchInput.addEventListener('input', applyFilterAndSort);
    filterNetwork.addEventListener('change', applyFilterAndSort);
    filterClient.addEventListener('change', applyFilterAndSort);
    filterPrice.addEventListener('change', applyFilterAndSort);
    sortOrder.addEventListener('change', applyFilterAndSort);
    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);
  }

  document.addEventListener('DOMContentLoaded', initBrandFilter);
</script>
